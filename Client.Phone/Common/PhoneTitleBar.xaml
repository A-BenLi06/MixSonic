<UserControl x:Class="Mixdrome.Phone.Common.PhoneTitleBar"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Bar" Background="#DD202020" SizeChanged="OnBarSizeChanged">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="HomeColumn" Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Button x:Name="HomeButton" Style="{StaticResource MixRadioFlatButtonStyle}" Click="OnHomeClick">
   <Viewbox x:Name="HomeGlyph" Width="25" Height="25"><Path Fill="White" Data="M0,0 L25,0 25,10 0,10 Z M0,15 L10,15 10,25 0,25 Z M15,15 L25,15 25,25 15,25 Z"/></Viewbox>
  </Button>
  <Rectangle x:Name="Divider" Width="1" Height="44" Fill="#FF626262" HorizontalAlignment="Right"/>
  <Button x:Name="ElapsedButton" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource MixRadioFlatButtonStyle}" Click="OnElapsedClick">
   <Grid x:Name="ElapsedClip"><TextBlock x:Name="ElapsedText" Foreground="White" Opacity="0.1" FontWeight="Black" TextAlignment="Right"/></Grid>
  </Button>
  <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Foreground="White" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
 </Grid>
</UserControl>
