<UserControl x:Class="Mixdrome.Phone.Common.PhoneHomePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="TileGrid">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="LargeTileColumn"/><ColumnDefinition x:Name="SmallTileColumn"/></Grid.ColumnDefinitions>
   <StackPanel>
    <Button x:Name="PlayMeButton" Tag="playme" HorizontalAlignment="Left" Style="{StaticResource PhoneHubTileButtonStyle}" Background="{StaticResource MixRadioPlayMeBrush}" Click="OnTileClick">
     <Grid>
      <Image x:Name="PlayMeImage" Source="/Assets/MixRadio/PlayMeTileIcon.png" Stretch="Uniform"/>
      <TextBlock x:Name="PlayMeLabel" x:Uid="PhoneUi_Text_PlayMe" Style="{StaticResource PhoneLargeTileLabelStyle}"/>
      <Image x:Name="CurrentImage" Stretch="UniformToFill" Visibility="Collapsed" ImageFailed="OnCurrentImageFailed"/>
      <Rectangle x:Name="CurrentShade" Fill="Black" Opacity="0.1" Visibility="Collapsed"/>
      <Grid x:Name="CurrentClip" Visibility="Collapsed"><TextBlock x:Name="CurrentElapsed" Foreground="White" Opacity="0.7" FontWeight="SemiBold" VerticalAlignment="Bottom"/></Grid>
      <TextBlock x:Name="CurrentTitle" Style="{StaticResource PhoneLargeTileLabelStyle}" Visibility="Collapsed"/>
     </Grid>
    </Button>
    <Button x:Name="CreateMixButton" Tag="create" HorizontalAlignment="Right" Style="{StaticResource PhoneHubTileButtonStyle}" Click="OnTileClick"><Grid><Image x:Name="CreateMixImage" Source="/Assets/MixRadio/CreateTileIcon.png" Stretch="Uniform"/><TextBlock x:Name="CreateMixLabel" Style="{StaticResource PhoneTileLabelStyle}"/></Grid></Button>
    <Button x:Name="RecentAlbumThree" HorizontalAlignment="Right" Style="{StaticResource PhoneHubTileButtonStyle}" Background="Transparent" Click="OnRecentClick"><Image x:Name="RecentImageThree" Stretch="UniformToFill"/></Button>
    <Button x:Name="RecentLink" Tag="recent" HorizontalAlignment="Left" Style="{StaticResource MixRadioFlatButtonStyle}" Click="OnTileClick"><TextBlock x:Name="RecentLabel" x:Uid="PhoneUi_Text_RecentlyPlayed" Foreground="White"/></Button>
   </StackPanel>
   <StackPanel x:Name="OffsetColumn" Grid.Column="1">
    <Button x:Name="RecentAlbumOne" HorizontalAlignment="Left" Style="{StaticResource PhoneHubTileButtonStyle}" Background="Transparent" Click="OnRecentClick"><Image x:Name="RecentImageOne" Stretch="UniformToFill"/></Button>
    <Button x:Name="MixOneButton" HorizontalAlignment="Left" Tag="mixes" Style="{StaticResource PhoneHubTileButtonStyle}" Click="OnTileClick"><Grid><Image x:Name="MixOneImage" Source="/Assets/MixRadio/MixesTileIcon.png" Stretch="UniformToFill"/><Border x:Name="MixOneBand" VerticalAlignment="Bottom" Background="{ThemeResource PhoneAccentBrush}" Opacity="0.6" Visibility="Collapsed"/><TextBlock x:Name="MixOneLabel" Style="{StaticResource PhoneTileLabelStyle}" SizeChanged="OnMixLabelSizeChanged"/></Grid></Button>
    <Button x:Name="RecentAlbumTwo" HorizontalAlignment="Left" Style="{StaticResource PhoneHubTileButtonStyle}" Background="Transparent" Click="OnRecentClick"><Image x:Name="RecentImageTwo" Stretch="UniformToFill"/></Button>
    <Button x:Name="MixTwoButton" HorizontalAlignment="Left" Tag="offline" Style="{StaticResource PhoneHubTileButtonStyle}" Click="OnTileClick"><Grid><Image x:Name="MixTwoImage" Source="/Assets/MixRadio/OfflineTileIcon.png" Stretch="UniformToFill"/><Border x:Name="MixTwoBand" VerticalAlignment="Bottom" Background="{ThemeResource PhoneAccentBrush}" Opacity="0.6" Visibility="Collapsed"/><TextBlock x:Name="MixTwoLabel" Style="{StaticResource PhoneTileLabelStyle}" SizeChanged="OnMixLabelSizeChanged"/></Grid></Button>
   </StackPanel>
  </Grid>
</UserControl>
