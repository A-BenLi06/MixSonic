<UserControl x:Class="Mixdrome.Phone.Common.PhoneHomePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollMode="Enabled" HorizontalScrollMode="Disabled" ZoomMode="Disabled">
        <StackPanel>
            <Grid x:Name="TileGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LargeTileColumn" Width="*" />
                    <ColumnDefinition x:Name="SmallTileColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Button x:Name="PlayMeButton" HorizontalAlignment="Left" Tag="playme"
                            Style="{StaticResource PhoneHubTileButtonStyle}"
                            Background="{StaticResource MixRadioAccentBrush}" Click="OnTileClick">
                        <Grid>
                            <Viewbox Stretch="Uniform">
                                <Canvas Width="{StaticResource PhoneHomeLargeTileSize}" Height="{StaticResource PhoneHomeLargeTileSize}">
                                    <Path Data="F1 M 158.609,110.590 L 82.246,154.688 C 79.619,156.201 77.465,154.963 77.465,151.941 L 77.465,63.744 C 77.465,60.712 79.619,59.461 82.246,60.982 L 158.609,105.078 C 161.236,106.596 161.236,109.077 158.609,110.590" Fill="White" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Uid="PhoneUi_Text_PlayMe" Style="{StaticResource PhoneLargeTileLabelStyle}" />
                        </Grid>
                    </Button>
                    <Button x:Name="MixesButton" HorizontalAlignment="Right" Tag="playlists"
                            Style="{StaticResource PhoneHubTileButtonStyle}" Click="OnTileClick">
                        <Grid>
                            <Image Source="/Assets/MixRadio/MixesTileIcon.png" Stretch="Uniform" />
                            <TextBlock x:Uid="PhoneUi_Text_Mixes" Style="{StaticResource PhoneTileLabelStyle}" />
                        </Grid>
                    </Button>
                    <Grid x:Name="RecentTileThree" HorizontalAlignment="Right">
                        <Rectangle x:Name="RecentPlaceholderThree" Fill="{ThemeResource PhoneAccentBrush}" Opacity="0.6" />
                        <Button x:Name="RecentAlbumThree" IsEnabled="False" Visibility="Collapsed"
                                Style="{StaticResource PhoneHubTileButtonStyle}" Click="OnRecentClick">
                            <Grid>
                                <Image x:Name="RecentImageThree" Stretch="UniformToFill" />
                                <TextBlock x:Name="RecentTitleThree" Style="{StaticResource PhoneRecentTitleStyle}" VerticalAlignment="Bottom" />
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="OffsetColumn" Grid.Column="1">
                    <Grid x:Name="RecentTileOne" HorizontalAlignment="Left">
                        <Rectangle x:Name="RecentPlaceholderOne" Fill="{ThemeResource PhoneAccentBrush}" Opacity="0.6" />
                        <Button x:Name="RecentAlbumOne" IsEnabled="False" Visibility="Collapsed"
                                Style="{StaticResource PhoneHubTileButtonStyle}" Click="OnRecentClick">
                            <Grid>
                                <Image x:Name="RecentImageOne" Stretch="UniformToFill" />
                                <TextBlock x:Name="RecentTitleOne" Style="{StaticResource PhoneRecentTitleStyle}" VerticalAlignment="Bottom" />
                            </Grid>
                        </Button>
                    </Grid>
                    <Button x:Name="MyMusicButton" HorizontalAlignment="Left" Tag="library"
                            Style="{StaticResource PhoneHubTileButtonStyle}" Click="OnTileClick">
                        <Grid>
                            <Image Source="/Assets/MixRadio/MyMusicTileIcon.png" Stretch="Uniform" />
                            <TextBlock x:Uid="PhoneUi_Text_MyMusic" Style="{StaticResource PhoneTileLabelStyle}" />
                        </Grid>
                    </Button>
                    <Grid x:Name="RecentTileTwo" HorizontalAlignment="Left">
                        <Rectangle x:Name="RecentPlaceholderTwo" Fill="{ThemeResource PhoneAccentBrush}" Opacity="0.6" />
                        <Button x:Name="RecentAlbumTwo" IsEnabled="False" Visibility="Collapsed"
                                Style="{StaticResource PhoneHubTileButtonStyle}" Click="OnRecentClick">
                            <Grid>
                                <Image x:Name="RecentImageTwo" Stretch="UniformToFill" />
                                <TextBlock x:Name="RecentTitleTwo" Style="{StaticResource PhoneRecentTitleStyle}" VerticalAlignment="Bottom" />
                            </Grid>
                        </Button>
                    </Grid>
                    <Button x:Name="FavouritesButton" HorizontalAlignment="Left" Tag="favourites"
                            Style="{StaticResource PhoneHubTileButtonStyle}" Click="OnTileClick">
                        <Grid>
                            <Image Source="/Assets/MixRadio/FavouritesTileIcon.png" Stretch="Uniform" />
                            <TextBlock x:Uid="PhoneUi_Text_Favourites" Style="{StaticResource PhoneTileLabelStyle}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
            <Button Tag="recent" Style="{StaticResource MixRadioFlatButtonStyle}" Click="OnTileClick" MinHeight="48">
                <TextBlock x:Uid="PhoneUi_Text_RecentlyPlayed" Style="{StaticResource TitleTextStyle}" />
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
