<UserControl x:Class="Mixdrome.Phone.Common.PhoneHomePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollMode="Enabled" HorizontalScrollMode="Disabled" ZoomMode="Disabled">
<StackPanel>
<Viewbox Stretch="Uniform" HorizontalAlignment="Left"><Grid Width="408">
<Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="168" /></Grid.ColumnDefinitions>
<StackPanel>
<Button x:Name="PlayMeButton" Width="228" Height="228" Margin="0,0,12,12" Tag="playme" Style="{StaticResource PhoneHubTileButtonStyle}" Background="{StaticResource MixRadioAccentBrush}" Click="OnTileClick"><Grid><Viewbox><Canvas Width="228" Height="228"><Path Data="F1 M 158.609,110.590 L 82.246,154.688 C 79.619,156.201 77.465,154.963 77.465,151.941 L 77.465,63.744 C 77.465,60.712 79.619,59.461 82.246,60.982 L 158.609,105.078 C 161.236,106.596 161.236,109.077 158.609,110.590" Fill="White" /></Canvas></Viewbox><TextBlock x:Uid="PhoneUi_Text_PlayMe" Style="{StaticResource PhoneTileLabelStyle}" /></Grid></Button>
<Button Width="168" Height="168" HorizontalAlignment="Right" Margin="0,0,12,12" Tag="playlists" Style="{StaticResource PhoneHubTileButtonStyle}" Click="OnTileClick"><Grid><Image Source="/Assets/MixRadio/MixesTileIcon.png" Stretch="Uniform" /><TextBlock x:Uid="PhoneUi_Text_Mixes" Style="{StaticResource PhoneTileLabelStyle}" /></Grid></Button>
<Button x:Name="RecentAlbumThree" Width="96" Height="96" IsEnabled="False" HorizontalAlignment="Right" Margin="0,0,12,12" Style="{StaticResource PhoneHubTileButtonStyle}" Click="OnRecentClick"><Grid><Image x:Name="RecentImageThree" Stretch="UniformToFill" /><Border Background="#99000000" VerticalAlignment="Bottom"><TextBlock x:Name="RecentTitleThree" Style="{StaticResource PhoneRecentTitleStyle}" /></Border></Grid></Button>
</StackPanel>
<StackPanel Grid.Column="1" Margin="0,24,0,0">
<Button x:Name="RecentAlbumOne" Width="96" Height="96" IsEnabled="False" HorizontalAlignment="Left" Margin="0,0,12,12" Style="{StaticResource PhoneHubTileButtonStyle}" Click="OnRecentClick"><Grid><Image x:Name="RecentImageOne" Stretch="UniformToFill" /><Border Background="#99000000" VerticalAlignment="Bottom"><TextBlock x:Name="RecentTitleOne" Style="{StaticResource PhoneRecentTitleStyle}" /></Border></Grid></Button>
<Button Width="168" Height="168" HorizontalAlignment="Right" Margin="0,0,12,12" Tag="library" Style="{StaticResource PhoneHubTileButtonStyle}" Click="OnTileClick"><Grid><Image Source="/Assets/MixRadio/MyMusicTileIcon.png" Stretch="Uniform" /><TextBlock x:Uid="PhoneUi_Text_MyMusic" Style="{StaticResource PhoneTileLabelStyle}" /></Grid></Button>
<Button x:Name="RecentAlbumTwo" Width="96" Height="96" IsEnabled="False" HorizontalAlignment="Left" Margin="0,0,12,12" Style="{StaticResource PhoneHubTileButtonStyle}" Click="OnRecentClick"><Grid><Image x:Name="RecentImageTwo" Stretch="UniformToFill" /><Border Background="#99000000" VerticalAlignment="Bottom"><TextBlock x:Name="RecentTitleTwo" Style="{StaticResource PhoneRecentTitleStyle}" /></Border></Grid></Button>
<Button Width="168" Height="168" HorizontalAlignment="Right" Margin="0,0,12,12" Tag="favourites" Style="{StaticResource PhoneHubTileButtonStyle}" Click="OnTileClick"><Grid><Image Source="/Assets/MixRadio/FavouritesTileIcon.png" Stretch="Uniform" /><TextBlock x:Uid="PhoneUi_Text_Favourites" Style="{StaticResource PhoneTileLabelStyle}" /></Grid></Button>
</StackPanel>
</Grid></Viewbox>
<Button Tag="recent" Style="{StaticResource MixRadioFlatButtonStyle}" Click="OnTileClick" MinHeight="48"><TextBlock x:Uid="PhoneUi_Text_RecentlyPlayed" Style="{StaticResource TitleTextStyle}" /></Button>
</StackPanel></ScrollViewer></UserControl>
