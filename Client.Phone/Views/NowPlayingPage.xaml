<Page
    x:Class="Mixdrome.Phone.Views.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource ApplicationPageBackgroundThemeBrush}">

    <Page.BottomAppBar>
        <CommandBar Background="{StaticResource MixRadioCommandBarBrush}" Foreground="White">
            <AppBarButton Icon="Refresh" Label="refresh" Click="OnRefreshClick" />
        </CommandBar>
    </Page.BottomAppBar>

    <Grid Background="Black">
        <Image x:Name="BackgroundImage"
               Source="/Assets/CoverArtPlaceholderLarge.jpg"
               Stretch="UniformToFill"
               Opacity="0.5" />
        <Rectangle Fill="#66000000" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#11000000" Offset="0" />
                    <GradientStop Color="#88000000" Offset="0.5" />
                    <GradientStop Color="#FF000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="12,10,12,20">
                <TextBlock Style="{StaticResource MixRadioWordmarkTextStyle}"><Run x:Uid="BrandPrefix" FontWeight="Bold" /><Run x:Uid="BrandSuffix" FontWeight="Light" /></TextBlock>
                <StackPanel Orientation="Horizontal" Margin="1,-4,0,14">
                    <Border Style="{StaticResource MixRadioSectionIconBorderStyle}">
                        <TextBlock Text="&#xE102;"
                                   Style="{StaticResource MixRadioSectionIconTextStyle}"
                                   Margin="1,0,0,0" />
                    </Border>
                    <TextBlock Text="server activity"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="White"
                               Margin="7,-1,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="now"
                               FontSize="42"
                               FontWeight="Light"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                    <TextBlock Text=" playing"
                               FontSize="42"
                               FontWeight="Light"
                               Foreground="#99FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                </StackPanel>
                <TextBlock x:Name="EntryCountText"
                           Text="server activity"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,4,0,0" />
                <Rectangle Width="64"
                           Height="4"
                           Fill="{StaticResource MixRadioAccentBrush}"
                           HorizontalAlignment="Left"
                           Margin="0,16,0,0" />
            </StackPanel>

            <Grid Grid.Row="1">
                <ListView ItemsSource="{Binding Entries}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnEntryClick"
                          Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="74" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,0,12,10"
                                  MinHeight="76"
                                  Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0"
                                       Source="{Binding CoverArt}"
                                       Width="64"
                                       Height="64"
                                       Stretch="UniformToFill"
                                       VerticalAlignment="Top" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="24"
                                               FontWeight="Light"
                                               Foreground="White"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Text="{Binding Artist}"
                                               Style="{StaticResource BodyTextStyle}"
                                               Foreground="#CCFFFFFF"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Text="{Binding Activity}"
                                               FontSize="13"
                                               Foreground="{StaticResource MixRadioTealBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <Rectangle Grid.Row="1"
                                           Grid.Column="1"
                                           Fill="#26FFFFFF" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing x:Name="LoadingIndicator"
                              IsActive="False"
                              Width="60"
                              Height="60"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />

                <TextBlock x:Name="EmptyStateText"
                           Text="Nobody is playing right now"
                           FontSize="30"
                           FontWeight="Light"
                           Foreground="White"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="42"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>
