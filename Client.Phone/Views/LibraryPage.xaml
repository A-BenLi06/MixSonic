<Page x:Class="Mixdrome.Phone.Views.LibraryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
<Page.Resources><DataTemplate x:Key="LibraryRowTemplate">
<Grid Margin="12,0,12,12" MinHeight="72"><Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
<Image Source="{Binding CoverArt}" Width="72" Height="72" Stretch="UniformToFill" />
<StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="26" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1" /><TextBlock Text="{Binding Subtitle}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" /></StackPanel>
</Grid></DataTemplate></Page.Resources>
<Page.BottomAppBar><CommandBar Background="{StaticResource MixRadioCommandBarBrush}"><AppBarButton Icon="Find" x:Uid="PhoneUi_Label_Search" Click="OnSearchClick" /><AppBarButton Icon="Refresh" x:Uid="PhoneUi_Label_Refresh" Click="OnRefreshClick" /><AppBarButton x:Name="MoreButton" Icon="More" x:Uid="PhoneUi_Label_More" Click="OnMoreClick" Visibility="Collapsed" /></CommandBar></Page.BottomAppBar>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<TextBlock x:Uid="PhoneUi_Text_MyMusic" Style="{StaticResource BodyTextStyle}" Foreground="White" Margin="20,12,20,0" />
<Pivot x:Name="LibraryPivot" Grid.Row="1" SelectionChanged="OnTabChanged"><PivotItem x:Uid="PhoneUi_Header_Artists" Tag="artists"><ListView ItemsSource="{Binding Artists}" ItemTemplate="{StaticResource LibraryRowTemplate}" ItemContainerStyle="{StaticResource AlbumListItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnItemClick" /></PivotItem>
<PivotItem x:Uid="PhoneUi_Header_Albums" Tag="albums"><ListView ItemsSource="{Binding Albums}" ItemTemplate="{StaticResource LibraryRowTemplate}" ItemContainerStyle="{StaticResource AlbumListItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnItemClick" /></PivotItem>
<PivotItem x:Uid="PhoneUi_Header_Songs" Tag="songs"><ListView ItemsSource="{Binding Songs}" ItemTemplate="{StaticResource LibraryRowTemplate}" ItemContainerStyle="{StaticResource AlbumListItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnItemClick" /></PivotItem>
<PivotItem x:Uid="PhoneUi_Header_Genres" Tag="genres"><ListView ItemsSource="{Binding Genres}" ItemTemplate="{StaticResource LibraryRowTemplate}" ItemContainerStyle="{StaticResource AlbumListItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnItemClick" /></PivotItem>
<PivotItem x:Uid="PhoneUi_Header_Playlists" Tag="playlists"><ListView ItemsSource="{Binding Playlists}" ItemTemplate="{StaticResource LibraryRowTemplate}" ItemContainerStyle="{StaticResource AlbumListItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnItemClick" /></PivotItem></Pivot>
<StackPanel Grid.Row="2" Margin="20,0,20,12"><TextBlock x:Name="StatusText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" /><ProgressRing x:Name="LoadingIndicator" IsActive="False" Width="32" Height="32" Visibility="Collapsed" /></StackPanel>
</Grid></Page>
