<Page x:Class="Mixdrome.Phone.Views.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Mixdrome.Phone.Common" Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
    <Page.BottomAppBar><CommandBar Background="{StaticResource MixRadioCommandBarBrush}">
        <AppBarButton Icon="Find" x:Uid="PhoneUi_Label_Search" Click="OnSearchClick" />
        <AppBarButton Icon="Refresh" x:Uid="PhoneUi_Label_Refresh" Click="OnRefreshClick" />
        <AppBarButton Icon="Setting" x:Uid="PhoneUi_Label_Account" Click="OnSettingsClick" />
    </CommandBar></Page.BottomAppBar>
    <Grid>
        <Hub x:Name="HomeHub" Orientation="Horizontal" Padding="0" Background="Transparent">
            <Hub.Header><TextBlock x:Uid="PhoneUi_Text_MixDrome" Style="{StaticResource MixRadioWordmarkTextStyle}" Margin="0,12,0,8" /></Hub.Header>
            <HubSection x:Name="PlaySection" Padding="10,0,0,0"><DataTemplate><local:PhoneHomePanel Loaded="OnHomePanelLoaded" /></DataTemplate></HubSection>
            <HubSection x:Name="MusicSection" Padding="10,0,0,0"><DataTemplate>
                <ScrollViewer VerticalScrollMode="Enabled" HorizontalScrollMode="Disabled" ZoomMode="Disabled"><Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Grid.Row="0" Grid.Column="0" Tag="library" Style="{StaticResource PhoneMenuTileStyle}" SizeChanged="OnMenuTileSizeChanged" Click="OnMenuClick"><Grid><Image Source="/Assets/MixRadio/MyMusicTileIcon.png" Stretch="Uniform" /><TextBlock x:Uid="PhoneUi_Text_MyMusic" Style="{StaticResource PhoneTileLabelStyle}" /></Grid></Button>
<Button Grid.Row="0" Grid.Column="1" Tag="playlists" Style="{StaticResource PhoneMenuTileStyle}" SizeChanged="OnMenuTileSizeChanged" Click="OnMenuClick"><Grid><Image Source="/Assets/MixRadio/MixesTileIcon.png" Stretch="Uniform" /><TextBlock x:Uid="PhoneUi_Text_Mixes" Style="{StaticResource PhoneTileLabelStyle}" /></Grid></Button>
<Button Grid.Row="1" Grid.Column="0" Tag="artists" Style="{StaticResource PhoneMenuTileStyle}" SizeChanged="OnMenuTileSizeChanged" Click="OnMenuClick"><Grid><Image Source="/Assets/MixRadio/MyMusicTileIcon.png" Stretch="Uniform" /><TextBlock x:Uid="PhoneUi_Text_Artists" Style="{StaticResource PhoneTileLabelStyle}" /></Grid></Button>
<Button Grid.Row="1" Grid.Column="1" Tag="albums" Style="{StaticResource PhoneMenuTileStyle}" SizeChanged="OnMenuTileSizeChanged" Click="OnMenuClick"><Grid><Image Source="/Assets/MixRadio/MyMusicTileIcon.png" Stretch="Uniform" /><TextBlock x:Uid="PhoneUi_Text_Albums" Style="{StaticResource PhoneTileLabelStyle}" /></Grid></Button>
<Button Grid.Row="2" Grid.Column="0" Tag="genres" Style="{StaticResource PhoneMenuTileStyle}" SizeChanged="OnMenuTileSizeChanged" Click="OnMenuClick"><Grid><Image Source="/Assets/MixRadio/MyMusicTileIcon.png" Stretch="Uniform" /><TextBlock x:Uid="PhoneUi_Text_Genres" Style="{StaticResource PhoneTileLabelStyle}" /></Grid></Button>
<Button Grid.Row="2" Grid.Column="1" Tag="radio" Style="{StaticResource PhoneMenuTileStyle}" SizeChanged="OnMenuTileSizeChanged" Click="OnMenuClick"><Grid><Image Source="/Assets/MixRadio/MixesTileIcon.png" Stretch="Uniform" /><TextBlock x:Uid="PhoneUi_Text_Radio" Style="{StaticResource PhoneTileLabelStyle}" /></Grid></Button>
<Button Grid.Row="3" Grid.Column="0" Tag="search" Style="{StaticResource PhoneMenuTileStyle}" SizeChanged="OnMenuTileSizeChanged" Click="OnMenuClick"><Grid><TextBlock Text="&#xE11A;" Style="{StaticResource PhoneTileGlyphStyle}" /><TextBlock x:Uid="PhoneUi_Text_Search" Style="{StaticResource PhoneTileLabelStyle}" /></Grid></Button>
<Button Grid.Row="3" Grid.Column="1" Tag="activity" Style="{StaticResource PhoneMenuTileStyle}" SizeChanged="OnMenuTileSizeChanged" Click="OnMenuClick"><Grid><TextBlock Text="&#xE121;" Style="{StaticResource PhoneTileGlyphStyle}" /><TextBlock x:Uid="PhoneUi_Text_Activity" Style="{StaticResource PhoneTileLabelStyle}" /></Grid></Button>
                    <Button Grid.Row="4" Grid.ColumnSpan="2" Tag="player" Style="{StaticResource MixRadioFlatButtonStyle}" MinHeight="48" Click="OnMenuClick"><TextBlock x:Uid="PhoneUi_Text_NowPlaying" Style="{StaticResource TitleTextStyle}" /></Button>
                </Grid></ScrollViewer>
            </DataTemplate></HubSection>
        </Hub>
        <StackPanel VerticalAlignment="Bottom" Margin="12" Background="{StaticResource MixRadioPanelBrush}">
            <TextBlock x:Name="StatusText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
            <ProgressRing x:Name="LoadingIndicator" IsActive="False" Width="32" Height="32" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
