<Page
    x:Class="Mixdrome.Phone.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource ApplicationPageBackgroundThemeBrush}">

    <Page.BottomAppBar>
        <CommandBar Background="{StaticResource MixRadioCommandBarBrush}" Foreground="White">
            <AppBarButton Icon="Find" Label="search" Click="OnSearchButtonClick" />
            <AppBarButton Icon="Clear" Label="clear" Click="OnClearClick" />
        </CommandBar>
    </Page.BottomAppBar>

    <Grid Background="Black">
        <Image Source="/Assets/CoverArtPlaceholderLarge.jpg"
               Stretch="UniformToFill"
               Opacity="0.48" />
        <Rectangle Fill="#66000000" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#22000000" Offset="0" />
                    <GradientStop Color="#88000000" Offset="0.42" />
                    <GradientStop Color="#F2000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="12,10,12,10">
                <TextBlock Style="{StaticResource MixRadioWordmarkTextStyle}"><Run x:Uid="BrandPrefix" FontWeight="Bold" /><Run x:Uid="BrandSuffix" FontWeight="Light" /></TextBlock>
                <StackPanel Orientation="Horizontal" Margin="1,-4,0,0">
                    <Border Width="19"
                            Height="19"
                            BorderBrush="White"
                            BorderThickness="2"
                            CornerRadius="9.5">
                        <TextBlock Text="&#xE11A;"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="8"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="search"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="White"
                               Margin="7,-1,0,0" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1"
                  Margin="12,0,12,22"
                  Background="{StaticResource MixRadioTealBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         PlaceholderText="Find artists, music or gigs"
                         Style="{StaticResource MixRadioSearchTextBoxStyle}"
                         KeyDown="OnSearchTextBoxKeyDown" />

                <Button Grid.Column="1"
                        Style="{StaticResource MixRadioFlatButtonStyle}"
                        Background="{StaticResource MixRadioTealBrush}"
                        Click="OnSearchButtonClick">
                    <TextBlock Text="&#xE11A;"
                               FontFamily="Segoe UI Symbol"
                               FontSize="22"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <ListView x:Name="ResultsListView"
                          ItemsSource="{Binding Results}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnResultClick"
                          Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="58" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,0,12,16"
                                  MinHeight="58"
                                  Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Rectangle Grid.Column="0"
                                           Fill="{Binding AccentBrush}"
                                           Opacity="0.96" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="30"
                                               FontWeight="Light"
                                               Foreground="White"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding KindLabel}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding AccentBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                        <TextBlock Text="  "
                                                   FontSize="13" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="15"
                                                   Foreground="#CCFFFFFF"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing x:Name="LoadingIndicator"
                              IsActive="False"
                              Width="60"
                              Height="60"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />

                <TextBlock x:Name="EmptyStateText"
                           Text="Type something to search your music."
                           FontSize="28"
                           FontWeight="Light"
                           Foreground="White"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="42"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>
