<Page
    x:Class="Mixdrome.Phone.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
    <Page.BottomAppBar>
        <CommandBar Background="{StaticResource MixRadioCommandBarBrush}" Foreground="White">
            <AppBarButton x:Name="SaveButton" x:Uid="Settings_Save" Icon="Save" Click="OnSaveClick" />
            <AppBarButton x:Name="TestButton" x:Uid="Settings_Test" Icon="Sync" Click="OnTestConnectionClick" />
        </CommandBar>
    </Page.BottomAppBar>
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="12,10,12,22">
            <TextBlock x:Uid="Settings_Brand" Style="{StaticResource MixRadioWordmarkTextStyle}" />
            <TextBlock x:Uid="Settings_Title" FontSize="42" FontWeight="Light" Foreground="White" />
            <Border Height="4" Width="64" Background="{StaticResource MixRadioAccentBrush}"
                    HorizontalAlignment="Left" Margin="0,16,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="12,0,12,0">
            <StackPanel x:Name="SettingsFields" Margin="0,0,0,32">
                <TextBlock x:Uid="Settings_Server" FontSize="24" FontWeight="Light"
                           Foreground="{StaticResource MixRadioTealBrush}" Margin="0,0,0,6" />
                <TextBlock x:Uid="Settings_PrimaryLabel" Style="{StaticResource SettingsTextStyle}" />
                <TextBox x:Name="PrimaryUrlTextBox" x:Uid="Settings_PrimaryUrl"
                         InputScope="Url" Style="{StaticResource SettingsTextBoxStyle}" />
                <TextBlock x:Uid="Settings_SecondaryLabel" Style="{StaticResource SettingsTextStyle}" />
                <TextBox x:Name="SecondaryUrlTextBox" x:Uid="Settings_SecondaryUrl"
                         InputScope="Url" Style="{StaticResource SettingsTextBoxStyle}" />
                <TextBlock x:Uid="Settings_Account" FontSize="24" FontWeight="Light"
                           Foreground="{StaticResource MixRadioYellowBrush}" Margin="0,20,0,6" />
                <TextBlock x:Uid="Settings_UsernameLabel" Style="{StaticResource SettingsTextStyle}" />
                <TextBox x:Name="UsernameTextBox" x:Uid="Settings_Username"
                         Style="{StaticResource SettingsTextBoxStyle}" />
                <ComboBox x:Name="AuthenticationComboBox" x:Uid="Settings_Authentication"
                          DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                          SelectionChanged="OnAuthenticationChanged" Margin="0,4,0,8" />
                <TextBlock x:Name="CredentialLabel" Style="{StaticResource SettingsTextStyle}" />
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource SettingsPasswordBoxStyle}" />
                <TextBlock x:Name="CredentialHelp" Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap" Margin="0,0,0,10" />
                <TextBlock x:Uid="Settings_Playback" FontSize="24" FontWeight="Light"
                           Foreground="{StaticResource MixRadioAccentBrush}" Margin="0,20,0,6" />
                <TextBlock x:Uid="Settings_StreamFormatLabel" Style="{StaticResource SettingsTextStyle}" />
                <TextBox x:Name="StreamingFormatTextBox" x:Uid="Settings_StreamFormat"
                         Style="{StaticResource SettingsTextBoxStyle}" />
                <TextBlock x:Uid="Settings_StreamFormatHelp" Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock x:Uid="Settings_MaximumBitRateLabel" Style="{StaticResource SettingsTextStyle}" />
                <TextBox x:Name="MaximumBitRateTextBox" x:Uid="Settings_MaximumBitRate"
                         InputScope="Number" Style="{StaticResource SettingsTextBoxStyle}" />
                <ToggleSwitch x:Name="CompatibleModeToggle" x:Uid="Settings_Compatibility" Margin="0,8,0,0" />
                <TextBlock x:Uid="Settings_CompatibilityHelp" Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap" Margin="0,0,0,18" />
                <ProgressRing x:Name="ConnectionProgress" HorizontalAlignment="Left" />
                <TextBlock x:Name="StatusText" Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap" Margin="0,8,0,24" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
