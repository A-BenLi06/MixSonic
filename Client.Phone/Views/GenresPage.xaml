<Page
    x:Class="Subsonic8.Phone.Views.GenresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource ApplicationPageBackgroundThemeBrush}">

    <Page.BottomAppBar>
        <CommandBar Background="{StaticResource MixRadioCommandBarBrush}" Foreground="White">
            <AppBarButton Icon="Refresh" Label="refresh" Click="OnRefreshClick" />
        </CommandBar>
    </Page.BottomAppBar>

    <Grid Background="Black">
        <Image Source="/Assets/CoverArtPlaceholderLarge.jpg" Stretch="UniformToFill" Opacity="0.48" />
        <Rectangle Fill="#66000000" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#11000000" Offset="0" />
                    <GradientStop Color="#88000000" Offset="0.52" />
                    <GradientStop Color="#FF000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="12,10,12,18">
                <TextBlock Text="MixRadio" Style="{StaticResource MixRadioWordmarkTextStyle}" />
                <StackPanel Orientation="Horizontal"
                            Margin="0,-4,0,0">
                    <TextBlock Text="featured"
                               FontSize="42"
                               FontWeight="Light"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                    <TextBlock Text=" categories"
                               FontSize="42"
                               FontWeight="Light"
                               Foreground="#99FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1">
                <GridView ItemsSource="{Binding Genres}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnGenreClick"
                          Margin="8,0,8,0">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Vertical" MaximumRowsOrColumns="2" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Width" Value="216" />
                            <Setter Property="Height" Value="146" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="208"
                                  Height="138"
                                  Margin="4"
                                  Background="{StaticResource MixRadioPanelAltBrush}">
                                <Image Source="/Assets/CoverArtPlaceholder.jpg"
                                       Stretch="UniformToFill"
                                       Opacity="0.72" />
                                <Rectangle Fill="#55000000" />
                                <Border Width="34"
                                        Height="34"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="{Binding AccentBrush}"
                                        Opacity="0.92">
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="18"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Rectangle Height="42"
                                           Fill="{Binding AccentBrush}"
                                           VerticalAlignment="Bottom"
                                           Opacity="0.94" />
                                <StackPanel VerticalAlignment="Bottom"
                                            Margin="9,0,9,5">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="17"
                                               Foreground="White"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="11"
                                               Foreground="#E6FFFFFF"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <ProgressRing x:Name="LoadingIndicator" IsActive="False" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="EmptyStateText"
                           Text="No genres found."
                           Style="{StaticResource BodyTextStyle}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="42"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>
