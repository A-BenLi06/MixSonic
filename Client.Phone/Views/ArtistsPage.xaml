<Page
    x:Class="Mixdrome.Phone.Views.ArtistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource ApplicationPageBackgroundThemeBrush}">

    <Page.BottomAppBar>
        <CommandBar Background="{StaticResource MixRadioCommandBarBrush}" Foreground="White">
            <AppBarButton Icon="Refresh" x:Uid="PhoneUi_Label_Refresh" Click="OnRefreshClick" />
        </CommandBar>
    </Page.BottomAppBar>

    <Grid Background="Black">
        <Image Source="ms-appx:///Assets/MixRadio/DefaultArtist300.png" Stretch="UniformToFill" Opacity="0.48" />
        <Rectangle Fill="#66000000" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#11000000" Offset="0" />
                    <GradientStop Color="#88000000" Offset="0.52" />
                    <GradientStop Color="#FF000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="12,10,12,18">
                <TextBlock x:Uid="PhoneUi_Text_MixRadio" Style="{StaticResource MixRadioWordmarkTextStyle}" />
                <StackPanel Orientation="Horizontal" Margin="1,-4,0,0">
                    <Border Style="{StaticResource MixRadioSectionIconBorderStyle}">
                        <TextBlock Text="&#xE13D;"
                                   Style="{StaticResource MixRadioSectionIconTextStyle}" />
                    </Border>
                    <TextBlock x:Uid="PhoneUi_Text_Artists"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="White"
                               Margin="7,-1,0,0" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1">
                <ListView x:Name="ArtistsListView"
                          ItemsSource="{Binding Artists}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnArtistClick"
                          Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="58" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,0,12,12"
                                  MinHeight="58"
                                  Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Initial}"
                                           FontSize="24"
                                           Foreground="{StaticResource MixRadioYellowBrush}"
                                           FontWeight="Light"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="2,0,10,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="29"
                                               FontWeight="Light"
                                               Foreground="White"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               Style="{StaticResource BodyTextStyle}"
                                               Foreground="#CCFFFFFF"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                </StackPanel>
                                <Rectangle Grid.Column="1"
                                           Height="1"
                                           Fill="#26FFFFFF"
                                           VerticalAlignment="Bottom" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing x:Name="LoadingIndicator"
                              IsActive="False"
                              Width="60"
                              Height="60"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                <TextBlock x:Name="EmptyStateText"
                           x:Uid="PhoneUi_Text_NoArtistsFound"
                           Style="{StaticResource BodyTextStyle}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="42"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>
