<Page
    x:Class="Subsonic8.Phone.Views.PlaybackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Storyboard x:Name="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="SongInfoPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="1"
                             To="0"
                             Duration="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="AlbumArtBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="1"
                             To="0"
                             Duration="0:0:0.15" />
        </Storyboard>

        <Storyboard x:Name="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="SongInfoPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetName="AlbumArtBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.25" />
        </Storyboard>

        <Storyboard x:Name="BackgroundFadeStoryboard">
            <DoubleAnimation Storyboard.TargetName="BackgroundImage"
                             Storyboard.TargetProperty="Opacity"
                             From="0.18"
                             To="0.48"
                             Duration="0:0:0.4" />
        </Storyboard>
    </Page.Resources>

    <Grid Background="Black">
        <Image x:Name="BackgroundImage"
               Source="/Assets/CoverArtPlaceholderLarge.jpg"
               Stretch="UniformToFill"
               Opacity="0.52" />

        <Rectangle Fill="#66000000" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33000000" Offset="0" />
                    <GradientStop Color="#22000000" Offset="0.26" />
                    <GradientStop Color="#AA000000" Offset="0.66" />
                    <GradientStop Color="#F2000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="12,10,12,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="MixRadio"
                           Style="{StaticResource MixRadioWordmarkTextStyle}" />
                <StackPanel Orientation="Horizontal" Margin="1,-4,0,0">
                    <Border Style="{StaticResource MixRadioSectionIconBorderStyle}">
                        <TextBlock Text="&#xE102;"
                                   Style="{StaticResource MixRadioSectionIconTextStyle}"
                                   Margin="1,0,0,0" />
                    </Border>
                    <TextBlock Text="now playing"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="White"
                               Margin="7,-1,0,0" />
                </StackPanel>
            </StackPanel>

            <Border x:Name="AlbumArtBorder"
                    Grid.Row="1"
                    Width="286"
                    Height="286"
                    MaxWidth="306"
                    MaxHeight="306"
                    Background="{StaticResource MixRadioPanelAltBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,0">
                <Grid>
                    <Image x:Name="AlbumArtImage"
                           Source="/Assets/CoverArtPlaceholder.jpg"
                           Stretch="UniformToFill" />
                    <Rectangle Height="4"
                               Fill="{StaticResource MixRadioAccentBrush}"
                               VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <StackPanel x:Name="SongInfoPanel"
                        Grid.Row="2"
                        VerticalAlignment="Bottom"
                        Margin="0,20,0,16">
                <TextBlock x:Name="SongTitleText"
                           Text="Song Title"
                           FontSize="34"
                           FontWeight="Light"
                           Foreground="White"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxLines="2" />
                <TextBlock x:Name="ArtistText"
                           Text="Artist Name"
                           FontSize="20"
                           Foreground="#E6FFFFFF"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"
                           MaxLines="1"
                           Margin="0,4,0,0" />
                <Rectangle Width="64"
                           Height="4"
                           Fill="{StaticResource MixRadioAccentBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0" />
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentTimeText"
                           Text="0:00"
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="White"
                           VerticalAlignment="Center" />

                <Slider x:Name="ProgressSlider"
                        Grid.Column="1"
                        Margin="12,0"
                        ValueChanged="OnProgressSliderChanged"
                        Foreground="{StaticResource MixRadioAccentBrush}"
                        Background="#66FFFFFF" />

                <TextBlock x:Name="TotalTimeText"
                           Grid.Column="2"
                           Text="0:00"
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="White"
                           VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="4" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource CircularButtonStyle}"
                        Width="58"
                        Height="58"
                        HorizontalAlignment="Right"
                        Margin="0,0,24,0"
                        Click="OnPreviousClick">
                    <TextBlock Text="&#xE100;"
                               FontFamily="Segoe UI Symbol"
                               FontSize="24" />
                </Button>

                <Button x:Name="PlayPauseButton"
                        Grid.Column="1"
                        Style="{StaticResource CircularButtonStyle}"
                        Width="92"
                        Height="92"
                        Background="{StaticResource MixRadioAccentBrush}"
                        Click="OnPlayPauseClick">
                    <TextBlock Text="&#xE102;"
                               FontFamily="Segoe UI Symbol"
                               FontSize="38"
                               Margin="5,0,0,0" />
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource CircularButtonStyle}"
                        Width="58"
                        Height="58"
                        HorizontalAlignment="Left"
                        Margin="24,0,0,0"
                        Click="OnNextClick">
                    <TextBlock Text="&#xE101;"
                               FontFamily="Segoe UI Symbol"
                               FontSize="24" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
