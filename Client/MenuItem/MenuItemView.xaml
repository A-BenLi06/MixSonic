<UserControl
    x:Class="Subsonic8.MenuItem.MenuItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="using:Caliburn.Micro"
    xmlns:converters="using:Subsonic8.Converters">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Name="StringToVisibilityConverter"/>
        <cal:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Width="{Binding TileWidth}"
          Height="{Binding TileHeight}"
          Margin="5"
          Background="Transparent">
        <Grid Background="{Binding AccentBrush}"
              Visibility="{Binding IsCommandTile, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Image Source="{Binding CoverArt}"
                   Stretch="UniformToFill"
                   Opacity="{Binding ImageOpacity}" />

            <Border Background="#22000000"
                    Opacity="{Binding ImageOpacity}" />

            <TextBlock Text="{Binding Glyph}"
                       FontFamily="Segoe UI Symbol"
                       FontSize="72"
                       Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,0,26"
                       Visibility="{Binding Glyph, Converter={StaticResource StringToVisibilityConverter}}" />

            <Border Height="56"
                    VerticalAlignment="Bottom"
                    Background="{Binding CaptionBrush}">
                <Grid Margin="11,5,7,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                                   FontFamily="Segoe UI Light"
                                   FontSize="18"
                                   LineHeight="20"
                                   MaxHeight="40"
                                   TextWrapping="Wrap"
                                   TextTrimming="WordEllipsis" />
                        <TextBlock Text="{Binding Subtitle}"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                                   FontSize="11"
                                   LineHeight="13"
                                   MaxHeight="13"
                                   TextWrapping="NoWrap"
                                   TextTrimming="WordEllipsis"
                                   Opacity="0.82"
                                   Visibility="{Binding Subtitle, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="20"
                            Height="20"
                            CornerRadius="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            BorderBrush="{StaticResource ApplicationForegroundThemeBrush}"
                            BorderThickness="1.5"
                            Background="#33000000">
                        <TextBlock Text="&#xE102;"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="10"
                                   Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Background="{Binding AccentBrush}"
              Visibility="{Binding IsCommandTile, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
            <Image Source="{Binding CoverArt}"
                   Stretch="UniformToFill"
                   Opacity="{Binding ImageOpacity}" />

            <Rectangle Fill="#26000000"
                       Opacity="{Binding ImageOpacity}" />

            <TextBlock Text="{Binding Glyph}"
                       FontFamily="Segoe UI Symbol"
                       FontSize="54"
                       Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,0,24"
                       Visibility="{Binding Glyph, Converter={StaticResource StringToVisibilityConverter}}" />

            <Border Height="50"
                    VerticalAlignment="Bottom"
                    Background="{Binding CaptionBrush}">
                <Grid Margin="10,5,7,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                                   FontFamily="Segoe UI Light"
                                   FontSize="15"
                                   LineHeight="17"
                                   MaxHeight="34"
                                   TextWrapping="Wrap"
                                   TextTrimming="WordEllipsis" />
                        <TextBlock Text="{Binding Subtitle}"
                                   Margin="0,1,0,0"
                                   Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                                   FontSize="10"
                                   LineHeight="12"
                                   MaxHeight="12"
                                   TextWrapping="NoWrap"
                                   TextTrimming="WordEllipsis"
                                   Opacity="0.78"
                                   Visibility="{Binding Subtitle, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="18"
                            Height="18"
                            CornerRadius="9"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            BorderBrush="{StaticResource ApplicationForegroundThemeBrush}"
                            BorderThickness="1.4"
                            Background="#33000000">
                        <TextBlock Text="&#xE102;"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="8"
                                   Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
