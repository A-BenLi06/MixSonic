<UserControl
    x:Class="Mixdrome.MenuItem.MenuItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="using:Caliburn.Micro"
    xmlns:converters="using:Mixdrome.Converters">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Name="StringToVisibilityConverter"/>
        <cal:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Width="{Binding TileWidth}"
          Height="{Binding TileHeight}"
          Margin="4"
          Background="Transparent">
        <Grid Background="{Binding AccentBrush}"
              Visibility="{Binding IsCommandTile, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Image Source="{Binding CoverArt}"
                   Stretch="UniformToFill"
                   Opacity="{Binding ImageOpacity}" />

            <Border Background="#22000000"
                    Opacity="{Binding ImageOpacity}" />

            <TextBlock Text="{Binding Glyph}"
                       FontFamily="Segoe UI Symbol"
                       FontSize="78"
                       Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,0,20"
                       Visibility="{Binding Glyph, Converter={StaticResource StringToVisibilityConverter}}" />

            <Border Height="48"
                    VerticalAlignment="Bottom"
                    Background="{Binding CaptionBrush}">
                <Grid Margin="12,4,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                                   FontFamily="Segoe UI Light"
                                   FontSize="17"
                                   LineHeight="19"
                                   MaxHeight="38"
                                   TextWrapping="Wrap"
                                   TextTrimming="WordEllipsis" />
                        <TextBlock Text="{Binding Subtitle}"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                                   FontSize="11"
                                   LineHeight="13"
                                   MaxHeight="13"
                                   TextWrapping="NoWrap"
                                   TextTrimming="WordEllipsis"
                                   Opacity="0.82"
                                   Visibility="{Binding Subtitle, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="20"
                            Height="20"
                            CornerRadius="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            BorderBrush="{StaticResource ApplicationForegroundThemeBrush}"
                            BorderThickness="1.5"
                            Background="#33000000">
                        <TextBlock Text="&#xE102;"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="10"
                                   Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Background="{Binding AccentBrush}"
              Visibility="{Binding IsCommandTile, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
            <Image Source="{Binding CoverArt}"
                   Stretch="UniformToFill"
                   Opacity="{Binding ImageOpacity}" />

            <Rectangle Fill="#26000000"
                       Opacity="{Binding ImageOpacity}" />

            <TextBlock Text="{Binding Glyph}"
                       FontFamily="Segoe UI Symbol"
                       FontSize="58"
                       Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,0,18"
                       Visibility="{Binding Glyph, Converter={StaticResource StringToVisibilityConverter}}" />

            <Border Height="42"
                    VerticalAlignment="Bottom"
                    Background="{Binding CaptionBrush}">
                <Grid Margin="9,4,7,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                                   FontFamily="Segoe UI Light"
                                   FontSize="14"
                                   LineHeight="16"
                                   MaxHeight="32"
                                   TextWrapping="Wrap"
                                   TextTrimming="WordEllipsis" />
                        <TextBlock Text="{Binding Subtitle}"
                                   Margin="0,1,0,0"
                                   Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                                   FontSize="10"
                                   LineHeight="12"
                                   MaxHeight="12"
                                   TextWrapping="NoWrap"
                                   TextTrimming="WordEllipsis"
                                   Opacity="0.78"
                                   Visibility="{Binding Subtitle, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="16"
                            Height="16"
                            CornerRadius="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            BorderBrush="{StaticResource ApplicationForegroundThemeBrush}"
                            BorderThickness="1.3"
                            Background="#33000000">
                        <TextBlock Text="&#xE102;"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="7"
                                   Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
