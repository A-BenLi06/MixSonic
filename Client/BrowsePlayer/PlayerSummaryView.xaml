<UserControl
    x:Class="Mixdrome.BrowsePlayer.PlayerSummaryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="using:Caliburn.Micro"
    xmlns:converters="using:Mixdrome.Converters">
    <UserControl.Resources>
        <cal:BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="360" HorizontalAlignment="Left">
        <Image Source="{Binding CurrentItem.CoverArtUrl}" Width="258" Height="258"
               HorizontalAlignment="Left" Stretch="UniformToFill"
               Visibility="{Binding HasCurrentItem, Converter={StaticResource VisibleWhenTrue}}" />
        <TextBlock Text="{Binding Title}" FontFamily="Segoe UI Light" FontSize="28"
                   TextWrapping="Wrap" MaxHeight="88" Margin="0,18,0,0" />
        <TextBlock Text="{Binding Artist}" FontSize="18" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}" />
        <Grid DataContext="{Binding Progress}" Margin="0,18,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ProgressBar Grid.ColumnSpan="2" Maximum="{Binding ItemDurationInSeconds}" Value="{Binding PlaybackProgressInSeconds}"
                         Height="4" Foreground="{StaticResource MixRadioAccentBrush}" />
            <TextBlock Grid.Row="1" Text="{Binding PositionText}" FontSize="14" Margin="0,8,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DurationText}" FontSize="14" Margin="0,8,0,0" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Style="{StaticResource MixRadioTransportButtonStyle}" Content="&#xE100;" IsEnabled="{Binding HasQueue}"
                    AutomationProperties.Name="{Binding PreviousLabel}" cal:Message.Attach="[Event Click] = [Action Previous]" />
            <Button Style="{StaticResource MixRadioTransportButtonStyle}" Content="{Binding PlayPauseGlyph}" IsEnabled="{Binding HasQueue}"
                    Background="{StaticResource MixRadioAccentBrush}" AutomationProperties.Name="{Binding PlayPauseLabel}"
                    cal:Message.Attach="[Event Click] = [Action PlayPause]" />
            <Button Style="{StaticResource MixRadioTransportButtonStyle}" Content="&#xE101;" IsEnabled="{Binding HasQueue}"
                    AutomationProperties.Name="{Binding NextLabel}" cal:Message.Attach="[Event Click] = [Action Next]" />
            <Button Style="{StaticResource MixRadioTransportButtonStyle}" Content="&#xE14C;" IsEnabled="{Binding HasQueue}"
                    AutomationProperties.Name="{Binding QueueLabel}" cal:Message.Attach="[Event Click] = [Action OpenQueue]" />
            <Button Style="{StaticResource MixRadioTransportButtonStyle}" Content="&#xE10C;" x:Uid="PlayerOptions">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel>
                            <Button Content="{Binding FavouriteLabel}" IsEnabled="{Binding CanToggleFavourite}"
                                    cal:Action.TargetWithoutContext="{Binding}" cal:Message.Attach="[Event Click] = [Action ToggleFavourite]" />
                            <Button Content="{Binding RepeatLabel}" cal:Action.TargetWithoutContext="{Binding}"
                                    cal:Message.Attach="[Event Click] = [Action ToggleRepeat]" />
                            <Button Content="{Binding ShuffleLabel}" cal:Action.TargetWithoutContext="{Binding}"
                                    cal:Message.Attach="[Event Click] = [Action ToggleShuffle]" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
