<UserControl x:Class="Subsonic8.Settings.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="using:Caliburn.Micro" IsEnabled="{Binding CanEdit}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Stretch" Background="Transparent" Margin="0,0,18,24">
            <TextBlock x:Uid="Navidrome_SettingsTitle" FontFamily="{StaticResource FontFamilyLight}" FontSize="32"/>
            <TextBlock x:Uid="Navidrome_ServerTitle" FontFamily="{StaticResource FontFamilyLight}" FontSize="24" Margin="0,24,0,12"/>
            <TextBlock x:Uid="Navidrome_PrimaryAddressLabel" Style="{StaticResource SettingsTextStyle}"/>
            <TextBox x:Uid="Navidrome_PrimaryAddress" Text="{Binding Configuration.SubsonicServiceConfiguration.PrimaryUrl}" Style="{StaticResource SettingsTextBoxStyle}"
                cal:Message.Attach="[Event TextChanged]=[Action PrimaryUrlChanged($source)]"/>
            <TextBlock x:Uid="Navidrome_SecondaryAddressLabel" Style="{StaticResource SettingsTextStyle}"/>
            <TextBox x:Uid="Navidrome_SecondaryAddress" Text="{Binding Configuration.SubsonicServiceConfiguration.SecondaryUrl}" Style="{StaticResource SettingsTextBoxStyle}"
                cal:Message.Attach="[Event TextChanged]=[Action SecondaryUrlChanged($source)]"/>
            <TextBlock x:Uid="Navidrome_AccountTitle" FontFamily="{StaticResource FontFamilyLight}" FontSize="24" Margin="0,24,0,12"/>
            <TextBlock x:Uid="Navidrome_UsernameLabel" Style="{StaticResource SettingsTextStyle}"/>
            <TextBox x:Uid="Navidrome_Username" Text="{Binding Configuration.SubsonicServiceConfiguration.Username}" Style="{StaticResource SettingsTextBoxStyle}"
                cal:Message.Attach="[Event TextChanged]=[Action UsernameChanged($source)]"/>
            <TextBlock x:Uid="Navidrome_AuthenticationLabel" Style="{StaticResource SettingsTextStyle}"/>
            <ComboBox x:Uid="Navidrome_Authentication" ItemsSource="{Binding AuthenticationModes}" SelectedItem="{Binding SelectedAuthentication, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
            <TextBlock Text="{Binding CredentialLabel}" Style="{StaticResource SettingsTextStyle}" Margin="0,12,0,4"/>
            <PasswordBox x:Uid="Navidrome_AuthenticationSecret" Password="{Binding Configuration.SubsonicServiceConfiguration.Password}" Style="{StaticResource PasswordTextBoxStyle}"
                cal:Message.Attach="[Event PasswordChanged]=[Action PasswordChanged($source)]"/>
            <TextBlock Text="{Binding CredentialHelp}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock x:Uid="Navidrome_PlaybackTitle" FontFamily="{StaticResource FontFamilyLight}" FontSize="24" Margin="0,24,0,12"/>
            <TextBlock x:Uid="Navidrome_FormatLabel" Style="{StaticResource SettingsTextStyle}"/>
            <ComboBox x:Uid="Navidrome_Format" ItemsSource="{Binding StreamFormats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
            <TextBlock x:Uid="Navidrome_BitRateLabel" Style="{StaticResource SettingsTextStyle}" Margin="0,12,0,4"/>
            <TextBox x:Uid="Navidrome_BitRate" Text="{Binding MaximumBitRateText}" Style="{StaticResource SettingsTextBoxStyle}"
                cal:Message.Attach="[Event TextChanged]=[Action BitRateChanged($source)]"/>
            <TextBlock x:Uid="Navidrome_QualityHelp" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,12"/>
            <ToggleSwitch x:Uid="Navidrome_Notifications" IsOn="{Binding Configuration.UseToastNotifications, Mode=TwoWay}" Style="{StaticResource LightToggleSwitch}" Margin="0,12,0,0"/>
            <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,16,0,0"/>
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <ProgressRing IsActive="{Binding IsWorking}" Width="32" Height="32" HorizontalAlignment="Left" Margin="0,12,0,0"/>
            <Button x:Name="ApplyChanges" x:Uid="Navidrome_SaveSettings" Style="{StaticResource LightButton}" MinWidth="128" MinHeight="44" HorizontalAlignment="Right" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
