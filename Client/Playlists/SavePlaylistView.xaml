<framework:AppPage
    x:Class="Mixdrome.Playlists.SavePlaylistView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:framework="using:Mixdrome.Framework"
    xmlns:caliburn="using:Caliburn.Micro"
    xmlns:common="using:Mixdrome.Common"
    mc:Ignorable="d">

    <Grid Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <common:BrowseView/>
        
        <Border BorderThickness="0,2,0,0"
                BorderBrush="{StaticResource MixRadioAccentBrush}"
                Grid.Row="1"
                Padding="0"
                x:Name="ActionBar"
                Background="#F2000000">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle Fill="{StaticResource MixRadioAccentBrush}" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0,28,0">
                    <TextBlock Text="save"
                               Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                               FontFamily="Segoe UI Light"
                               FontSize="28" />
                    <TextBlock Text=" playlist"
                               Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}"
                               FontFamily="Segoe UI Light"
                               FontSize="28" />
                </StackPanel>
                <TextBox caliburn:Message.Attach="[Event TextChanged] = [PlaylistNameChanged($source)]"
                         Grid.Column="2"
                         Height="38"
                         Margin="0,14,18,14"
                         IsEnabled="{Binding Path=CanEdit}"
                         Text="{Binding Path=PlaylistName, Mode=OneWay}"
                         Style="{StaticResource SettingsTextBoxStyle}" />
                <StackPanel Orientation="Horizontal"
                            Grid.Column="3"
                            MinWidth="220"
                            VerticalAlignment="Center"
                            Margin="0,0,76,0">
                    <Button x:Name="Save"
                            Margin="10,0"
                            MinWidth="100"
                            Style="{StaticResource LightButton}"
                            Content="save"/>
                    <Button x:Name="Cancel"
                            Margin="10,0"
                            MinWidth="100"
                            IsEnabled="{Binding Path=CanEdit}"
                            Style="{StaticResource LightButton}"
                            Content="cancel"/>
                </StackPanel>
            </Grid>
        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ApplicationViewStates">
                <VisualState x:Name="FullScreenLandscape">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionBar" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Filled">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionBar" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="FullScreenPortrait">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionBar" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Snapped">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionBar" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</framework:AppPage>
