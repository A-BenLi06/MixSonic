<UserControl
    x:Class="Subsonic8.Playback.ProgressIndicatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Subsonic8.Converters"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">
    <UserControl.Resources>
        <converters:IntToTimeStringConverter x:Name="IntToTimeStringConverter" />
    </UserControl.Resources>

    <ProgressBar Width="320"
                 Height="8"
                 MinHeight="8"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="0,14,0,8"
                 Maximum="{Binding ItemDurationInSeconds, Mode=TwoWay}"
                 Value="{Binding PlaybackProgressInSeconds, Mode=TwoWay}"
                 Foreground="{StaticResource MixRadioAccentBrush}"
                 Background="#FF3A3A3A"
                 BorderBrush="Transparent"
                 ToolTipService.ToolTip="{Binding Path=PlaybackProgressInSeconds, Converter={StaticResource IntToTimeStringConverter}}" />
</UserControl>
