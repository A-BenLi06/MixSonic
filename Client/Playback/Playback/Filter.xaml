<UserControl
    x:Class="Subsonic8.Playback.Playback.Filter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cal="using:Caliburn.Micro"
    xmlns:controls="using:Common.Controls"
    mc:Ignorable="d"
    d:DesignHeight="324"
    d:DesignWidth="320">

    <UserControl.Resources>
        <Style x:Key="MixRadioFilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource ApplicationForegroundThemeBrush}" />
            <Setter Property="Background" Value="#E600AFAF" />
            <Setter Property="BorderBrush" Value="{StaticResource MixRadioTealBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,3" />
        </Style>

        <Style x:Key="MixRadioFilterDoneButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ApplicationForegroundThemeBrush}" />
            <Setter Property="Background" Value="{StaticResource MixRadioAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.9"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.72"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.36"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Width="320"
          Height="324"
          Background="Black">
        <Image Source="{Binding CoverArt}"
               Stretch="UniformToFill"
               Opacity="0.55" />

        <Rectangle Fill="#66000000" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#22000000" Offset="0" />
                    <GradientStop Color="#99000000" Offset="0.62" />
                    <GradientStop Color="#F2000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <StackPanel VerticalAlignment="Bottom"
                    Margin="0,0,0,18">
            <TextBlock Text="filter queue"
                       FontFamily="Segoe UI Light"
                       FontSize="34"
                       Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                       Margin="0,0,0,14" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="FilterTextBox"
                         Style="{StaticResource MixRadioFilterTextBoxStyle}"
                         controls:TextBoxEx.RealTimeText="{Binding Path=FilterText, Mode=TwoWay}"
                         controls:TextBoxEx.IsAutoUpdate="True"
                         KeyUp="FilterTextBox_OnKeyUp"
                         PlaceholderText="Song or artist" />

                <Button x:Name="DoneButton"
                        Grid.Column="1"
                        Style="{StaticResource MixRadioFilterDoneButtonStyle}"
                        AutomationProperties.Name="done"
                        cal:Message.Attach="[Event Click] = [Action DoneFiltering()]">
                    <TextBlock Text="&#xE10B;"
                               FontFamily="Segoe UI Symbol"
                               FontSize="20"
                               Foreground="{StaticResource ApplicationForegroundThemeBrush}" />
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
