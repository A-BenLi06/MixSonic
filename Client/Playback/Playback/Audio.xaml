<Page
    x:Class="Mixdrome.Playback.Playback.Audio"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:cal="using:Caliburn.Micro"
    xmlns:ic="using:Mixdrome.Controls"
    xmlns:effects="using:Callisto.Effects"
    xmlns:playback="using:Mixdrome.Playback"
    mc:Ignorable="d">

    <Page.Resources>
        <cal:BooleanToVisibilityConverter x:Name="BooleanToVisibilityConverter" />

        <Style x:Key="MixRadioPlaybackCircleButtonStyle" TargetType="ButtonBase">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="58" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="9,0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="Foreground" Value="{StaticResource ApplicationForegroundThemeBrush}" />
            <Setter Property="Background" Value="#22000000" />
            <Setter Property="BorderBrush" Value="{StaticResource ApplicationSecondaryForegroundThemeBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Grid Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">
                            <Ellipse x:Name="ButtonChrome"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonChrome"
                                                                           Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{StaticResource ApplicationForegroundThemeBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonChrome"
                                                                           Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{StaticResource MixRadioAccentBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonChrome"
                                                                           Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{StaticResource ApplicationForegroundThemeBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonChrome"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.32"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MixRadioPlaybackPrimaryButtonStyle"
               TargetType="ButtonBase"
               BasedOn="{StaticResource MixRadioPlaybackCircleButtonStyle}">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="72" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="FontSize" Value="31" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource MixRadioAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ApplicationForegroundThemeBrush}" />
        </Style>

        <Style x:Key="MixRadioPreviousCircleButtonStyle"
               TargetType="ButtonBase"
               BasedOn="{StaticResource MixRadioPlaybackCircleButtonStyle}">
            <Setter Property="Content" Value="&#xE100;" />
        </Style>

        <Style x:Key="MixRadioPlayCircleButtonStyle"
               TargetType="ButtonBase"
               BasedOn="{StaticResource MixRadioPlaybackPrimaryButtonStyle}">
            <Setter Property="Content" Value="&#xE102;" />
        </Style>

        <Style x:Key="MixRadioPauseCircleButtonStyle"
               TargetType="ButtonBase"
               BasedOn="{StaticResource MixRadioPlaybackPrimaryButtonStyle}">
            <Setter Property="Content" Value="&#xE103;" />
        </Style>

        <Style x:Key="MixRadioStopCircleButtonStyle"
               TargetType="ButtonBase"
               BasedOn="{StaticResource MixRadioPlaybackCircleButtonStyle}">
            <Setter Property="Content" Value="&#xE15B;" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Margin" Value="9,15,9,0" />
        </Style>

        <Style x:Key="MixRadioNextCircleButtonStyle"
               TargetType="ButtonBase"
               BasedOn="{StaticResource MixRadioPlaybackCircleButtonStyle}">
            <Setter Property="Content" Value="&#xE101;" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="320"
              Height="324">
            <Image Source="{Binding CoverArt}"
                   Style="{StaticResource PlaybackBigCoverArtStyle}"
                   effects:Tilt.IsTiltEnabled="True" />
            <Rectangle Height="4"
                       Fill="{StaticResource MixRadioAccentBrush}"
                       VerticalAlignment="Bottom" />
        </Grid>
        <playback:ProgressIndicatorView Grid.Row="1" cal:Bind.Model="{Binding ProgressIndicatorViewModel}" />
        <StackPanel Grid.Row="2" Style="{StaticResource PlaybackControlsPanelStyle}"
                    Visibility="{Binding Path=PlaybackControlsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button Style="{StaticResource MixRadioPreviousCircleButtonStyle}"
                    cal:Message.Attach="[Event Click] = [Action Previous]" />
            <ic:AppBarToggleButton Style="{StaticResource MixRadioPlayCircleButtonStyle}"
                                   CheckedStyle="{StaticResource MixRadioPauseCircleButtonStyle}"
                                   cal:Message.Attach="[Event Click] = [Action PlayPause()]" AutoToggle="False"
                                   IsChecked="{Binding IsPlaying}" />
            <Button Style="{StaticResource MixRadioNextCircleButtonStyle}" cal:Message.Attach="[Event Click] = [Action Next]" />
            <Button Style="{StaticResource MixRadioStopCircleButtonStyle}" cal:Message.Attach="[Event Click] = [Action Stop]" />
        </StackPanel>
    </Grid>
</Page>
