<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cal="using:Caliburn.Micro">
    <cal:BooleanToVisibilityConverter x:Key="NavidromeVisibility" />
    <DataTemplate x:Key="NavidromeTileTemplate">
        <Grid Width="170" Height="226" Margin="0,0,10,12" Background="{StaticResource MixRadioPanelAltBrush}">
            <Grid.RowDefinitions><RowDefinition Height="170"/><RowDefinition Height="56"/></Grid.RowDefinitions>
            <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
            <TextBlock Text="★" FontSize="22" Margin="8" Foreground="White" Visibility="{Binding IsStarred, Converter={StaticResource NavidromeVisibility}}"/>
            <Border Grid.Row="1" Background="{StaticResource MixRadioAccentBrush}" Padding="8,4"><StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="17" FontFamily="Segoe UI Light" TextTrimming="WordEllipsis"/>
                <TextBlock Text="{Binding Kind}" FontSize="11" TextTrimming="WordEllipsis"/>
            </StackPanel></Border>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="NavidromeTrackTemplate">
        <Grid MinHeight="68" Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Image Source="{Binding ImageUrl}" Width="52" Height="52" Stretch="UniformToFill"/>
            <StackPanel Grid.Column="1" Margin="12,4,0,4">
                <TextBlock Text="{Binding Title}" FontSize="19" FontFamily="Segoe UI Light" TextTrimming="WordEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}" TextTrimming="WordEllipsis"/>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
