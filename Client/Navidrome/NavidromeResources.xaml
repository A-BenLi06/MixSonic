        <Grid>


                <Grid Width="158">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.Children>
                        <TextBlock Grid.Row="0" MaxHeight="88" Margin="0,0,24,5" VerticalAlignment="Bottom" LineStackingStrategy="MaxHeight" Style="{StaticResource Medium2LightText}" Text="{Binding Path=Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Title}" />
