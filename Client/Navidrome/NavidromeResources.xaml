    <!-- Common/NokiaMusicClient.json: MyMusicInfoItemTemplate; data bindings adapted to Navidrome. -->
    <ControlTemplate x:Key="MyMusicInfoItemTemplate">
        <Grid>
            <Grid.Children>
                <Border Background="{StaticResource MyMusicInfo}" Opacity="{StaticResource MyMusicTextBoxOpacity}" />
                <StackPanel>
                    <StackPanel.Children>
                        <TextBlock Margin="13,5,14,0" Text="{Binding Path=Title}" Style="{StaticResource NormalText}" VerticalAlignment="Bottom" HorizontalAlignment="Left" TextTrimming="WordEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Margin="13,2,14,0" Text="{Binding Path=Artist}" Style="{StaticResource NormalText}" VerticalAlignment="Bottom" HorizontalAlignment="Left" TextTrimming="WordEllipsis" TextWrapping="NoWrap" />
                    </StackPanel.Children>
                </StackPanel>
            </Grid.Children>
        </Grid>
    </ControlTemplate>

    <!-- Common/NokiaMusicClient.json: RadioStationInfoItemTemplate; data bindings adapted to Navidrome. -->
    <ControlTemplate x:Key="RadioStationInfoItemTemplate">
        <Grid>
            <Grid.Children>
                <Border Background="{StaticResource RadioStationInfo}" Opacity="{StaticResource RadioTextBoxOpacity}" />
                <TextBlock Margin="13,0,32,7" Text="{Binding Path=Title}" Style="{StaticResource NormalText}" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                <Image Source="ms-appx:///Assets/MixRadio/play.png" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,7,7" Stretch="None" />
            </Grid.Children>
        </Grid>
    </ControlTemplate>

    <!-- Common/DesignAssets.json: MyMusicAlbumPlayIcon; data bindings adapted to Navidrome. -->
    <ControlTemplate x:Key="MyMusicAlbumPlayIcon" TargetType="ContentControl">
        <Canvas CacheMode="BitmapCache">
            <Canvas.Children>
                <Path Data="F1 M 31.000,16.000 C 31.000,24.284 24.284,31.000 16.000,31.000 C 7.715,31.000 1.000,24.284 1.000,16.000 C 1.000,7.716 7.715,1.000 16.000,1.000 C 24.284,1.000 31.000,7.716 31.000,16.000 Z" Fill="#ff211e1e" Opacity="0.2" />
                <Path Data="F1 M 13.432,10.065 L 13.432,22.124 L 21.381,16.067 L 13.432,10.065 Z" Fill="#ffffffff" />
                <Path Data="F1 M 31.000,16.000 C 31.000,24.284 24.284,31.000 16.000,31.000 C 7.715,31.000 1.000,24.284 1.000,16.000 C 1.000,7.716 7.715,1.000 16.000,1.000 C 24.284,1.000 31.000,7.716 31.000,16.000 Z" Stroke="#fffefefe" StrokeMiterLimit="1" StrokeThickness="2" />
            </Canvas.Children>
        </Canvas>
    </ControlTemplate>

    <!-- Views/MyMusic/MyMusicPanel.json: MyMusicItemSmallTemplate; data bindings adapted to Navidrome. -->
    <DataTemplate x:Key="MixRadioHomeAlbumTemplate">
        <Grid Height="162" Width="162" HorizontalAlignment="Left" Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>
            <Grid.Children>
                <ContentControl Grid.RowSpan="2" Template="{StaticResource MyMusicArtworkTemplate}" />
                <ContentControl Grid.Row="1" Template="{StaticResource MyMusicInfoItemTemplate}" />
            </Grid.Children>
        </Grid>
    </DataTemplate>

    <!-- Views/Search/SearchResultsView.json: ArtistTileTemplate; data bindings adapted to Navidrome. -->
    <DataTemplate x:Key="MixRadioHomeArtistTemplate">
        <Grid Height="162" Width="162" HorizontalAlignment="Left" Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>
            <Grid.Children>
                <common:MixRadioArtwork Source="{Binding Path=ImageUrl}" Grid.RowSpan="2" DefaultSource="ms-appx:///Assets/MixRadio/W8_Music_asset_DefaulPackArt_200px.png"  />
                <Grid Grid.Row="1">
                    <Grid.Children>
                        <Border Background="{StaticResource MyMusicInfo}" Opacity="0.55000001" />
                        <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,7">
                            <StackPanel.Children>
                                <TextBlock Margin="13,5,14,0" Text="{Binding Path=Title}" Style="{StaticResource NormalText}" VerticalAlignment="Bottom" HorizontalAlignment="Left" TextWrapping="NoWrap" />
                            </StackPanel.Children>
                        </StackPanel>
                    </Grid.Children>
                </Grid>
            </Grid.Children>
        </Grid>
    </DataTemplate>

    <!-- Common/NokiaMusicClient.json: CuratedRadioStationItemSmallTemplate; data bindings adapted to Navidrome. -->
    <DataTemplate x:Key="MixRadioHomePlaylistTemplate">
        <Grid Height="162" Width="162" HorizontalAlignment="Left" Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>
            <Grid.Children>
                <ContentControl Grid.RowSpan="2" Template="{StaticResource CuratedRadioStationArtworkTemplate}" />
                <ContentControl Grid.Row="1" Template="{StaticResource RadioStationInfoItemTemplate}" />
            </Grid.Children>
        </Grid>
    </DataTemplate>

    <!-- Common/NokiaMusicClient.json: RadioStationItemExtraLargeTemplate; data bindings adapted to Navidrome. -->
    <DataTemplate x:Key="MixRadioHomeHeroTemplate">
        <Grid Height="332" Width="332" HorizontalAlignment="Left" Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>
            <Grid.Children>
                <ContentControl Grid.RowSpan="2" Template="{StaticResource CuratedRadioStationArtworkTemplate}" />
                <ContentControl Grid.Row="1" Template="{StaticResource RadioStationInfoItemTemplate}" />
            </Grid.Children>
        </Grid>
    </DataTemplate>

    <!-- Views/MyMusic/MyMusicView.json: MyMusicAlbumZoomedInTemplate; data bindings adapted to Navidrome. -->
    <DataTemplate x:Key="MixRadioLibraryAlbumTemplate">
        <Grid Width="260" Height="130" Margin="0,0,25,0" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.Children>
                <Grid Grid.Column="0" HorizontalAlignment="Stretch">
                    <Grid.Children>
                        <common:MixRadioArtwork Grid.RowSpan="2" DefaultSource="ms-appx:///Assets/MixRadio/PackArt-Explorer.Targetsize-256.png" FadeDuration="0"  Source="{Binding ImageUrl}" />
                        <ContentControl Width="32" Height="32" Margin="0,7,7,0" HorizontalAlignment="Right" VerticalAlignment="Top" Template="{StaticResource MyMusicAlbumPlayIcon}" />
                    </Grid.Children>
                </Grid>
                <Rectangle Grid.Column="1" Fill="Gray" Opacity="0.30000001" />
                <Grid Grid.Column="1" Width="130" Height="130" Background="Transparent">
                    <Grid.Children>
                        <StackPanel Grid.Column="1" Margin="10,6,6,0">
                            <StackPanel.Children>
                                <TextBlock MaxLines="3" LineHeight="21" ToolTipService.ToolTip="{Binding Title}" Style="{StaticResource Medium2LightText}" Text="{Binding Path=Title}" TextWrapping="Wrap" />
                                <TextBlock MaxLines="1" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding Artist}" Foreground="LightGray" LineHeight="21" Style="{StaticResource NormalSemiLightText}" Text="{Binding Path=Artist}" />
                                <TextBlock Foreground="LightGray" LineHeight="21" Style="{StaticResource NormalSemiLightText}" Text="{Binding CountText}" />
                            </StackPanel.Children>
                        </StackPanel>
                    </Grid.Children>
                </Grid>
            </Grid.Children>
        </Grid>
    </DataTemplate>

    <!-- Views/MyMusic/MyMusicView.json: MyMusicIndexZoomedInTemplate; data bindings adapted to Navidrome. -->
    <DataTemplate x:Key="MixRadioLibraryArtistTemplate">
        <Grid Width="260" Height="130" Margin="0,0,25,0" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.Children>
                <Grid Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.Children>
                        <Border Background="Black" BorderBrush="{StaticResource NokiaPinkBrush}" BorderThickness="3" Padding="12,4,12,5" ToolTipService.ToolTip="{Binding Subtitle}">
                            <Border.Child>
                                <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False" Style="{StaticResource ExtraLargeLightSubHeaderText}" MaxLines="3" TextTrimming="CharacterEllipsis" Text="{Binding Path=Title}" TextWrapping="Wrap" />
                            </Border.Child>
                        </Border>
                    </Grid.Children>
                </Grid>
            </Grid.Children>
        </Grid>
    </DataTemplate>

    <!-- Views/MyMusic/MyMusicView.json: MyMusicSongZoomedInTemplate; data bindings adapted to Navidrome. -->
    <DataTemplate x:Key="NavidromeTrackTemplate">
        <Grid Width="270" Height="65" Margin="0,0,25,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.Children>
                <Rectangle Grid.ColumnSpan="2" Fill="Gray" Opacity="0.30000001" />
                <common:MixRadioArtwork Grid.RowSpan="2" DefaultSource="ms-appx:///Assets/MixRadio/PackArt-Explorer.Targetsize-256.png" FadeDuration="0"  Source="{Binding ImageUrl}" />
                <StackPanel Grid.Column="1" Margin="7,5,0,8" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel.Children>
                        <TextBlock MaxWidth="172" Style="{StaticResource NormalLightText}" Text="{Binding Path=Title}" TextTrimming="WordEllipsis" TextWrapping="NoWrap" />
                        <TextBlock MaxWidth="172" Style="{StaticResource SmallGreyText}" Text="{Binding Path=Artist}" TextTrimming="WordEllipsis" TextWrapping="NoWrap" />
                        <TextBlock MaxWidth="172" Style="{StaticResource SmallGreyText}" Text="{Binding Path=Album}" TextTrimming="WordEllipsis" TextWrapping="NoWrap" />
                    </StackPanel.Children>
                </StackPanel>
            </Grid.Children>
        </Grid>
    </DataTemplate>

    <!-- Views/MyMusic/MyMusicPanel.json: MyMusicItemSmallTemplate; data bindings adapted to Navidrome. -->
    <DataTemplate x:Key="NavidromeTileTemplate">
        <Grid Height="162" Width="162" HorizontalAlignment="Left" Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>
            <Grid.Children>
                <ContentControl Grid.RowSpan="2" Template="{StaticResource MyMusicArtworkTemplate}" />
                <ContentControl Grid.Row="1" Template="{StaticResource MyMusicInfoItemTemplate}" />
            </Grid.Children>
        </Grid>
    </DataTemplate>
    <!-- Views/MyMusic/MyMusicView.json: MyMusicGenreZoomedInTemplate; data bindings adapted to Navidrome. -->
    <DataTemplate x:Key="MixRadioLibraryGenreAlbumTemplate">
        <Grid Width="260" Height="130" Margin="0,0,25,0" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.Children>
                <Grid>
                    <Grid.Children>
                        <common:MixRadioArtwork Grid.RowSpan="2" DefaultSource="ms-appx:///Assets/MixRadio/PackArt-Explorer.Targetsize-256.png"  Source="{Binding ImageUrl}" />
                        <ContentControl Width="32" Height="32" Margin="0,7,7,0" HorizontalAlignment="Right" VerticalAlignment="Top" Template="{StaticResource MyMusicAlbumPlayIcon}" />
                    </Grid.Children>
                </Grid>
                <Rectangle Grid.Column="1" Fill="Gray" Opacity="0.30000001" />
                <Grid Grid.Column="1" Width="130" Height="130" Background="Transparent">
                    <Grid.Children>
                        <StackPanel Grid.Column="1" Margin="10,6,6,0">
                            <StackPanel.Children>
                                <TextBlock MaxLines="3" LineHeight="21" ToolTipService.ToolTip="{Binding Title}" Style="{StaticResource Medium2LightText}" Text="{Binding Path=Title}" TextWrapping="Wrap" />
                                <TextBlock Foreground="LightGray" LineHeight="21" Style="{StaticResource NormalSemiLightText}" Text="{Binding CountText}" />
                                <TextBlock Foreground="LightGray" LineHeight="21" Style="{StaticResource NormalSemiLightText}" Text="{Binding YearText}" />
                            </StackPanel.Children>
                        </StackPanel>
                    </Grid.Children>
                </Grid>
            </Grid.Children>
        </Grid>
    </DataTemplate>
    <!-- Common/NokiaMusicClient.json: RadioStationItemOfflineTemplate; data bindings adapted to Navidrome. -->
    <DataTemplate x:Key="MixRadioOfflineTemplate">
        <Grid Height="162" Width="162" HorizontalAlignment="Left" Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>
            <Grid.Children>
                <ContentControl Grid.RowSpan="2" Template="{StaticResource CuratedRadioStationArtworkTemplate}" />
                <ContentControl Grid.Row="1" Template="{StaticResource RadioStationInfoItemTemplate}" />
                <Rectangle Visibility="{Binding CanPlay, Converter={StaticResource NavidromeHidden}}" Grid.RowSpan="2" Fill="Black" Opacity="0.60000002" Stretch="Fill" />
                <Grid Visibility="{Binding IsTransferring, Converter={StaticResource NavidromeVisibility}}" Grid.RowSpan="2">
                    <Grid.Children>
                        <StackPanel>
                            <StackPanel.Children>
                                <ProgressBar Maximum="100" Minimum="0" Value="{Binding Path=Progress}" Height="6" Foreground="{StaticResource NokiaPinkBrush}" />
                                <TextBlock Text="{Binding StateText}" Style="{StaticResource SmallRegularText}" Margin="8,14,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="8,2,0,0">
                                    <StackPanel.Children>
                                        <TextBlock Text="{Binding ProgressPercentText}" Style="{StaticResource SmallRegularText}" />
                                    </StackPanel.Children>
                                </StackPanel>
                            </StackPanel.Children>
                        </StackPanel>
                    </Grid.Children>
                </Grid>
                <StackPanel Grid.RowSpan="2" Margin="8,14,8,8" Visibility="{Binding CanPlay, Converter={StaticResource NavidromeHidden}}">
                    <TextBlock Text="{Binding StateText}" Style="{StaticResource SmallRegularText}" Visibility="{Binding IsTransferring, Converter={StaticResource NavidromeHidden}}" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource SmallRegularText}" Margin="0,8,0,0" MaxHeight="108" TextTrimming="WordEllipsis" ToolTipService.ToolTip="{Binding Error}" />
                </StackPanel>
            </Grid.Children>
        </Grid>
    </DataTemplate>
    <!-- Views/MyMusic/MyMusicView.json: ActiveCharacterGridTemplate; data bindings adapted to Navidrome. -->
    <DataTemplate x:Key="MixRadioActiveIndexTemplate">
        <Grid>

                <StackPanel Width="126" Height="106" Margin="0,0,0,0" Background="{StaticResource NokiaPinkBrush}">
                    <StackPanel.Children>
                        <TextBlock Margin="8,70,0,12" FontSize="26.67" Foreground="White" Style="{StaticResource Medium2LightText}" Text="{Binding Path=Title}" TextAlignment="Left" />
                    </StackPanel.Children>
                </StackPanel>

        </Grid>
    </DataTemplate>

    <!-- Views/MyMusic/MyMusicView.json: InactiveCharacterGridTemplate; data bindings adapted to Navidrome. -->
    <DataTemplate x:Key="MixRadioInactiveIndexTemplate">
        <Grid>

                <StackPanel Width="126" Height="106" Margin="0,0,0,0" Background="#414141">
                    <StackPanel.Children>
                        <TextBlock Margin="8,70,0,12" FontSize="26.67" Foreground="White" Style="{StaticResource Medium2LightText}" Text="{Binding Path=Title}" TextAlignment="Left" />
                    </StackPanel.Children>
                </StackPanel>

        </Grid>
    </DataTemplate>

    <!-- Views/MyMusic/MyMusicView.json: MyMusicArtistZoomedOutTemplate; data bindings adapted to Navidrome. -->
    <DataTemplate x:Key="MixRadioArtistIndexTemplate">
        <Grid>


                <Grid Width="158">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88" />
                        <RowDefinition Height="236" />
                    </Grid.RowDefinitions>
                    <Grid.Children>
                        <TextBlock Grid.Row="0" MaxHeight="88" Margin="0,0,24,5" VerticalAlignment="Bottom" LineStackingStrategy="MaxHeight" Style="{StaticResource Medium2LightText}" Text="{Binding Path=Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Title}" />
                        <Grid Grid.Row="1" Background="#414141">
                            <Grid.Children>
                                <Grid Background="{StaticResource NokiaPinkBrush}"><Image Source="ms-appx:///Assets/MixRadio/DefaultSemanticZoomArtist_158px.png" Width="158" Height="158" Stretch="Uniform"/></Grid>
                            </Grid.Children>
                        </Grid>
                    </Grid.Children>
                </Grid>

        </Grid>
    </DataTemplate>

    <!-- Views/MyMusic/MyMusicView.json: MyMusicGenreZoomedOutTemplate; data bindings adapted to Navidrome. -->
    <DataTemplate x:Key="MixRadioGenreIndexTemplate">
        <Grid>


                <Grid Width="158">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.Children>
                        <TextBlock Grid.Row="0" MaxHeight="88" Margin="0,0,24,5" VerticalAlignment="Bottom" LineStackingStrategy="MaxHeight" Style="{StaticResource Medium2LightText}" Text="{Binding Path=Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Title}" />
                        <Grid Grid.Row="1" Height="236">
                            <Grid.Children>
                                <Grid Background="{StaticResource NokiaPinkBrush}"></Grid>
                            </Grid.Children>
                        </Grid>
                    </Grid.Children>
                </Grid>

        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MixRadioSongIndexHeaderTemplate">
        <Grid Width="270" Height="65" Margin="0,0,25,0">
            <Border Background="Black" BorderBrush="{StaticResource NokiaPinkBrush}" BorderThickness="3" Padding="12,4,12,5">
                <TextBlock Text="{Binding Title}" Style="{StaticResource ExtraLargeLightSubHeaderText}" VerticalAlignment="Bottom"/>
            </Border>
        </Grid>
    </DataTemplate>
    <nav:MixRadioIndexTemplateSelector x:Key="MixRadioIndexSelector"
        ActiveTemplate="{StaticResource MixRadioActiveIndexTemplate}" InactiveTemplate="{StaticResource MixRadioInactiveIndexTemplate}"
        ArtistTemplate="{StaticResource MixRadioArtistIndexTemplate}" GenreTemplate="{StaticResource MixRadioGenreIndexTemplate}"/>
    <Style x:Key="MixRadioIndexItemStyle" TargetType="GridViewItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
    </Style>

    <!-- StandardButtonStyle's 162 px layout rendered inside the clickable GridViewItem. -->
    <DataTemplate x:Key="MixRadioNavigationTileTemplate">
        <Grid Width="162" Height="162" Background="{StaticResource NokiaPinkBrush}">
            <Grid.RowDefinitions><RowDefinition Height="90" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" FlowDirection="LeftToRight">
                <TextBlock Text="&#xE17F;" FontFamily="Segoe UI Symbol" FontSize="20" Foreground="Transparent" />
                <TextBlock Text="&#xE17E;" FontFamily="Segoe UI Symbol" FontSize="20" />
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Label}" Margin="15,15,15,0" TextAlignment="Center" Style="{StaticResource Medium2LightText}" />
        </Grid>
    </DataTemplate>
    <!-- MyMusic song-row layout for entities without artwork, such as a share or radio station. -->
    <DataTemplate x:Key="MixRadioLibraryTextTemplate">
        <Grid Width="270" Height="65" Margin="0,0,25,0">
            <Rectangle Fill="Gray" Opacity="0.3" />
            <StackPanel Margin="10,5,10,8">
                <TextBlock Text="{Binding Title}" Style="{StaticResource NormalLightText}" TextWrapping="NoWrap" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SmallGreyText}" TextWrapping="NoWrap" />
                <TextBlock Text="{Binding Kind}" Style="{StaticResource SmallGreyText}" TextWrapping="NoWrap" />
            </StackPanel>
        </Grid>
    </DataTemplate>
    <nav:MixRadioHomeTemplateSelector x:Key="MixRadioHomeSmallSelector"
        AlbumTemplate="{StaticResource MixRadioHomeAlbumTemplate}" ArtistTemplate="{StaticResource MixRadioHomeArtistTemplate}"
        PlaylistTemplate="{StaticResource MixRadioHomePlaylistTemplate}" LinkTemplate="{StaticResource MixRadioNavigationTileTemplate}" />
    <nav:MixRadioHomeTemplateSelector x:Key="MixRadioHomeSelector"
        AlbumTemplate="{StaticResource MixRadioHomeAlbumTemplate}" ArtistTemplate="{StaticResource MixRadioHomeArtistTemplate}"
        PlaylistTemplate="{StaticResource MixRadioHomePlaylistTemplate}" HeroTemplate="{StaticResource MixRadioHomeHeroTemplate}"
        LinkTemplate="{StaticResource MixRadioNavigationTileTemplate}" />
    <nav:MixRadioLibraryTemplateSelector x:Key="MixRadioLibrarySelector"
        IndexTemplate="{StaticResource MixRadioLibraryArtistTemplate}" SongIndexTemplate="{StaticResource MixRadioSongIndexHeaderTemplate}"
        GenreAlbumTemplate="{StaticResource MixRadioLibraryGenreAlbumTemplate}"
        AlbumTemplate="{StaticResource MixRadioLibraryAlbumTemplate}" ArtistTemplate="{StaticResource MixRadioLibraryArtistTemplate}"
        SongTemplate="{StaticResource NavidromeTrackTemplate}" TextTemplate="{StaticResource MixRadioLibraryTextTemplate}" />
    <Style x:Key="MixRadioLibraryAlbumItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource MyMusicItemContainerZoomedInAlbumStyle}">
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding Subtitle}" />
    </Style>
    <Style x:Key="MixRadioLibrarySongItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource MyMusicItemContainerZoomedInSongStyle}">
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding Subtitle}" />
    </Style>
    <nav:MixRadioLibraryContainerStyleSelector x:Key="MixRadioLibraryContainerSelector"
        AlbumStyle="{StaticResource MixRadioLibraryAlbumItemStyle}" SongStyle="{StaticResource MixRadioLibrarySongItemStyle}" />
    <Style x:Key="MixRadioLibraryMenuStyle" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="#211D1E" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="0" />
    </Style>
</ResourceDictionary>
