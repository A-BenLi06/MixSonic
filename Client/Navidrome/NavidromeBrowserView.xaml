<framework:AppPage x:Class="Subsonic8.Navidrome.NavidromeBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Subsonic8.Common" xmlns:framework="using:Subsonic8.Framework" xmlns:cal="using:Caliburn.Micro" xmlns:selection="using:Common.Behaviors" KeyDown="OnPageKeyDown">
    <Page.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="NavidromeResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Page.Resources>
    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Name="Play" x:Uid="Navidrome_Play" Icon="Play"/>
            <AppBarButton x:Name="PlayNext" x:Uid="Navidrome_PlayNext" Icon="Forward"/>
            <AppBarButton x:Name="Append" x:Uid="Navidrome_Append" Icon="Add"/>
            <AppBarButton x:Name="Details" x:Uid="Navidrome_Details" Icon="View"/>
            <AppBarButton x:Uid="Navidrome_Filter" Icon="Filter">
                <AppBarButton.Flyout><Flyout><StackPanel Width="280">
                    <TextBlock x:Uid="Navidrome_Library" FontSize="20"/>
                    <ComboBox ItemsSource="{Binding Session.Folders}" DisplayMemberPath="Name" SelectedItem="{Binding Session.SelectedFolder, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                    <StackPanel Visibility="{Binding IsAlbums, Converter={StaticResource NavidromeVisibility}}">
                        <TextBlock x:Uid="Navidrome_Sort" FontSize="20" Margin="0,16,0,4"/>
                        <ComboBox ItemsSource="{Binding AlbumSorts}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Uid="Navidrome_Genre" Margin="0,16,0,4"/>
                        <TextBox Text="{Binding GenreFilter, Mode=TwoWay}"/>
                        <TextBlock x:Uid="Navidrome_Years" Margin="0,16,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Uid="Navidrome_FromYear" Width="120" Text="{Binding FromYear, Mode=TwoWay}"/>
                            <TextBox x:Uid="Navidrome_ToYear" Width="120" Margin="16,0,0,0" Text="{Binding ToYear, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsRandom, Converter={StaticResource NavidromeVisibility}}">
                        <TextBlock x:Uid="Navidrome_RandomCountLabel" Margin="0,16,0,4"/>
                        <TextBox x:Uid="Navidrome_RandomCount" Text="{Binding RandomCount, Mode=TwoWay}"/>
                        <TextBlock x:Uid="Navidrome_Genre" Margin="0,16,0,4"/>
                        <TextBox Text="{Binding GenreFilter, Mode=TwoWay}"/>
                        <TextBlock x:Uid="Navidrome_Years" Margin="0,16,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Uid="Navidrome_FromYear" Width="120" Text="{Binding RandomFromYear, Mode=TwoWay}"/>
                            <TextBox x:Uid="Navidrome_ToYear" Width="120" Margin="16,0,0,0" Text="{Binding RandomToYear, Mode=TwoWay}"/>
                        </StackPanel>
                        <TextBlock x:Uid="Navidrome_RandomFilterHelp" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button x:Uid="Navidrome_Apply" Margin="0,20,0,0" cal:Message.Attach="[Event Click]=[Action Reload]"/>
                </StackPanel></Flyout></AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="Reload" x:Uid="Navidrome_Refresh" Icon="Refresh"/>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="Download" x:Uid="Navidrome_Download"/>
                <AppBarButton x:Name="Favourite" x:Uid="Navidrome_Favourite"/>
                <AppBarButton x:Name="Unfavourite" x:Uid="Navidrome_Unfavourite"/>
                <AppBarButton x:Uid="Navidrome_Rate" IsEnabled="{Binding CanRate}" cal:Message.Attach="[Event Click]=[Action Rate($source)]"/>
                <AppBarButton x:Uid="Navidrome_CreatePlaylist" IsEnabled="{Binding CanCreatePlaylist}" cal:Message.Attach="[Event Click]=[Action CreatePlaylist($source)]"/>
                <AppBarButton x:Uid="Navidrome_AddToPlaylist" IsEnabled="{Binding CanAddToPlaylist}" cal:Message.Attach="[Event Click]=[Action AddToPlaylist($source)]"/>
                <AppBarButton x:Uid="Navidrome_CreateShare" IsEnabled="{Binding CanCreateShare}" cal:Message.Attach="[Event Click]=[Action CreateShare($source)]"/>
                <AppBarButton x:Name="EditShare" x:Uid="Navidrome_EditShare" cal:Message.Attach="[Event Click]=[Action EditShare($source)]"/>
                <AppBarButton x:Name="CopyLink" x:Uid="Navidrome_CopyLink"/>
                <AppBarButton x:Name="Delete" x:Uid="Navidrome_Delete"/>
                <AppBarButton x:Name="CreateRadio" x:Uid="Navidrome_CreateRadio" cal:Message.Attach="[Event Click]=[Action CreateRadio($source)]"/>
                <AppBarButton x:Name="EditRadio" x:Uid="Navidrome_EditRadio" cal:Message.Attach="[Event Click]=[Action EditRadio($source)]"/>
                <AppBarButton x:Name="DeleteRadio" x:Uid="Navidrome_DeleteRadio"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
    <Grid x:Name="Canvas" Background="Black">
        <Grid.RowDefinitions><RowDefinition x:Name="HeaderHeight" Height="134"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="PageHeader">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="HeaderIndent" Width="116"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="GoBack" x:Uid="Navidrome_Back" Style="{StaticResource BackButtonStyle}"/>
            <TextBlock x:Name="PageTitle" x:Uid="Navidrome_LibraryTitle" Grid.Column="1" Style="{StaticResource PageHeaderTextStyle}"/>
            <Button x:Name="CurrentFilter" Grid.Column="2" Style="{StaticResource MyMusicFilterButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" Click="OnLibraryClicked">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CurrentFilterText" Text="{Binding DisplayName}" FontFamily="{StaticResource FontFamilyLight}" FontSize="40" Padding="8,7" TextTrimming="WordEllipsis"/>
                    <TextBlock Text="&#xE011;" FontFamily="Segoe UI Symbol" FontSize="24" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        <common:LibrarySearch x:Name="SearchControl" Width="270" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,32,0"/>
        <StackPanel x:Name="Feedback" Grid.Row="1" Margin="116,0,40,12">
            <TextBlock Text="{Binding Error}" Style="{StaticResource NormalText}" Foreground="{StaticResource NokiaPinkBrush}" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource NavidromeVisibility}}"/>
            <ProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" HorizontalAlignment="Left" Visibility="{Binding IsLoading, Converter={StaticResource NavidromeVisibility}}"/>
            <ProgressRing IsActive="{Binding IsWorking}" Width="32" Height="32" HorizontalAlignment="Left" Visibility="{Binding IsWorking, Converter={StaticResource NavidromeVisibility}}"/>
            <TextBlock x:Uid="Navidrome_ActivityRefreshHelp" Style="{StaticResource SmallGreyText}" Margin="0,8,0,0" Visibility="{Binding IsActivity, Converter={StaticResource NavidromeVisibility}}"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <TextBlock x:Name="EmptyMessage" x:Uid="Navidrome_EmptyCollection" Style="{StaticResource MediumLightText}" Margin="116,0,40,0" Visibility="{Binding IsEmpty, Converter={StaticResource NavidromeVisibility}}"/>
            <GridView x:Name="LibraryItems" ItemsSource="{Binding Items}" ItemTemplateSelector="{StaticResource MixRadioLibrarySelector}"
                ItemContainerStyle="{StaticResource GridViewItemStyle}" IsItemClickEnabled="True" SelectionMode="Multiple" Padding="116,0,40,20"
                ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                selection:MultipleSelectBehavior.SelectedItems="{Binding SelectedItems, Mode=TwoWay}" ItemClick="OnItemClicked">
                <GridView.ItemsPanel><ItemsPanelTemplate><WrapGrid Orientation="Vertical"/></ItemsPanelTemplate></GridView.ItemsPanel>
            </GridView>
        </Grid>
        <Button Grid.Row="3" x:Name="LoadMore" x:Uid="Navidrome_LoadMore" Style="{StaticResource NullButtonStyleWithPress}" Foreground="{StaticResource NokiaPinkBrush}"
            Margin="116,12,40,20" HorizontalAlignment="Left" Visibility="{Binding CanLoadMore, Converter={StaticResource NavidromeVisibility}}"/>
    </Grid>
</framework:AppPage>
