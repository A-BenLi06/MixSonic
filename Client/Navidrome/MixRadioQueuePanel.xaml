<UserControl x:Class="Subsonic8.Navidrome.MixRadioQueuePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Subsonic8.Common" xmlns:selection="using:Common.Behaviors" Width="300">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="NavidromeResources.xaml" /></ResourceDictionary.MergedDictionaries>
        <Style x:Key="QueueItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" />
        </Style>
    </ResourceDictionary></UserControl.Resources>
    <!-- PlayerQueue.json: 300 px pane, 84 px title, 56 px toolbar and 58 px queue entries. -->
    <Grid Background="Black">
        <Grid.RowDefinitions><RowDefinition Height="84" /><RowDefinition Height="56" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Background="{StaticResource NokiaSecondaryPinkBrush}">
            <TextBlock x:Uid="Navidrome_Queue" Margin="40,30,0,0" VerticalAlignment="Bottom" Style="{StaticResource MediumLightText}" />
            <Button x:Name="CloseButton" Style="{StaticResource ButtonBase}" Content="&#xE10A;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                x:Uid="Navidrome_CloseQueue" Click="OnCloseClicked" />
        </Grid>
        <Grid Grid.Row="1" Background="{StaticResource NokiaSecondaryPinkBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="56" /><ColumnDefinition Width="56" /><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="&#xE14B;" IsEnabled="{Binding CanShuffle}" AutomationProperties.Name="{Binding ShuffleLabel}" Click="OnShuffleClicked" />
            <Button Grid.Column="2" Style="{StaticResource ButtonBase}" Content="&#xE149;" IsEnabled="{Binding CanRepeat}" AutomationProperties.Name="{Binding RepeatLabel}" Click="OnRepeatClicked" />
            <Button Grid.Column="3" Style="{StaticResource ButtonBase}" Content="&#xE107;" IsEnabled="{Binding CanClearQueue}" x:Uid="Navidrome_ClearQueueButton" Click="OnClearClicked" />
        </Grid>
        <ListView x:Name="QueueList" Grid.Row="2" ItemsSource="{Binding QueueEntries}" ItemContainerStyle="{StaticResource QueueItemStyle}"
            IsItemClickEnabled="True" SelectionMode="Multiple" IsSwipeEnabled="True" ItemClick="OnQueueItemClicked"
            selection:MultipleSelectBehavior.SelectedItems="{Binding SelectedItems, Mode=TwoWay}">
            <ListView.ItemTemplate><DataTemplate>
                <Grid Height="58" Width="300">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Rectangle Grid.ColumnSpan="3" Height="56" Fill="{StaticResource NokiaPinkBrush}" Visibility="{Binding IsCurrent, Converter={StaticResource NavidromeVisibility}}" />
                    <TextBlock Text="{Binding Number}" Style="{StaticResource SmallGreyText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <common:MixRadioArtwork Grid.Column="1" Width="56" Height="56" FadeDuration="0" Source="{Binding Item.CoverArtUrl}" DefaultSource="ms-appx:///Assets/MixRadio/PackArt-Explorer.Targetsize-256.png" />
                    <StackPanel Grid.Column="2" Margin="8,0,4,0">
                        <TextBlock Text="{Binding Item.Title}" FontSize="18" LineHeight="20" MaxHeight="42" Style="{StaticResource Medium2LightText}" />
                        <TextBlock Text="{Binding Item.Artist}" LineHeight="14" MaxHeight="16" Style="{StaticResource SmallGreyText}" />
                    </StackPanel>
                </Grid>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
