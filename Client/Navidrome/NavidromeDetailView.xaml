<framework:AppPage x:Class="Subsonic8.Navidrome.NavidromeDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:framework="using:Subsonic8.Framework" xmlns:cal="using:Caliburn.Micro" xmlns:selection="using:Common.Behaviors">
    <Page.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="NavidromeResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Page.Resources>
    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Name="Play" x:Uid="Navidrome_Play" Icon="Play"/>
            <AppBarButton x:Name="PlayNext" x:Uid="Navidrome_PlayNext" Icon="Forward"/>
            <AppBarButton x:Name="Append" x:Uid="Navidrome_Append" Icon="Add"/>
            <AppBarButton x:Name="Favourite" x:Uid="Navidrome_Favourite" Icon="Favorite"/>
            <AppBarButton x:Name="Reload" x:Uid="Navidrome_Refresh" Icon="Refresh"/>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="Download" x:Uid="Navidrome_Download"/>
                <AppBarButton x:Name="Unfavourite" x:Uid="Navidrome_Unfavourite"/>
                <AppBarButton x:Uid="Navidrome_Rate" IsEnabled="{Binding CanRate}" cal:Message.Attach="[Event Click]=[Action Rate($source)]"/>
                <AppBarButton x:Name="ArtistMix" x:Uid="Navidrome_ArtistMix"/>
                <AppBarButton x:Name="TopSongs" x:Uid="Navidrome_TopSongs"/>
                <AppBarButton x:Uid="Navidrome_CreatePlaylist" IsEnabled="{Binding CanCreatePlaylist}" cal:Message.Attach="[Event Click]=[Action CreatePlaylist($source)]"/>
                <AppBarButton x:Uid="Navidrome_AddToPlaylist" IsEnabled="{Binding CanAddToPlaylist}" cal:Message.Attach="[Event Click]=[Action AddToPlaylist($source)]"/>
                <AppBarButton x:Name="EditPlaylist" x:Uid="Navidrome_EditPlaylist" cal:Message.Attach="[Event Click]=[Action EditPlaylist($source)]"/>
                <AppBarButton x:Name="RemoveTracks" x:Uid="Navidrome_RemoveTracks"/>
                <AppBarButton x:Name="MoveUp" x:Uid="Navidrome_MoveUp"/>
                <AppBarButton x:Name="MoveDown" x:Uid="Navidrome_MoveDown"/>
                <AppBarButton x:Name="DeletePlaylist" x:Uid="Navidrome_DeletePlaylist"/>
                <AppBarButton x:Name="OpenExternal" x:Uid="Navidrome_OpenExternal"/>
                <AppBarButton x:Name="Bookmark" x:Uid="Navidrome_SaveBookmark" cal:Message.Attach="[Event Click]=[Action Bookmark($source)]"/>
                <AppBarButton x:Uid="Navidrome_CreateShare" IsEnabled="{Binding CanCreateShare}" cal:Message.Attach="[Event Click]=[Action CreateShare($source)]"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Canvas" Margin="88,30,48,40">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="GoBack" Content="&#xE112;" FontFamily="Segoe UI Symbol" MinHeight="40" MinWidth="40"/>
                <TextBlock x:Name="PageTitle" Grid.Column="1" Text="{Binding DisplayName}" FontSize="44" FontFamily="Segoe UI Light" Margin="12,0,0,0" TextWrapping="Wrap"/>
            </Grid>
            <ProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" HorizontalAlignment="Left" Visibility="{Binding IsLoading, Converter={StaticResource NavidromeVisibility}}"/>
            <ProgressRing IsActive="{Binding IsWorking}" Width="32" Height="32" HorizontalAlignment="Left" Visibility="{Binding IsWorking, Converter={StaticResource NavidromeVisibility}}"/>
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource NavidromeVisibility}}"/>
            <Grid x:Name="Overview" Margin="0,24,0,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="ArtworkColumn" Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image x:Name="Artwork" Source="{Binding ImageUrl}" Width="250" Height="250" Stretch="UniformToFill" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <StackPanel x:Name="Information" Grid.Column="1">
                    <TextBlock Text="{Binding Current.Subtitle}" FontSize="22" TextWrapping="Wrap"/>
                    <TextBlock x:Uid="Navidrome_Starred" Text="★" FontSize="24" Foreground="{StaticResource MixRadioAccentBrush}" Visibility="{Binding Current.IsStarred, Converter={StaticResource NavidromeVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding Metadata}" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource MixRadioAccentBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding Value}" FontSize="17" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Notes}" FontSize="18" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,0,0,24" Visibility="{Binding HasNotes, Converter={StaticResource NavidromeVisibility}}"/>
            <TextBlock x:Uid="Navidrome_Tracks" FontSize="28" FontFamily="Segoe UI Light" Margin="0,0,0,12" Visibility="{Binding HasTracks, Converter={StaticResource NavidromeVisibility}}"/>
            <ListView ItemsSource="{Binding Tracks}" ItemTemplate="{StaticResource NavidromeTrackTemplate}" IsItemClickEnabled="True" SelectionMode="Multiple"
                MaxHeight="480" selection:MultipleSelectBehavior.SelectedItems="{Binding SelectedItems, Mode=TwoWay}" cal:Message.Attach="[Event ItemClick]=[Action PlayTrack($eventArgs)]"/>
            <TextBlock x:Uid="Navidrome_Related" FontSize="28" FontFamily="Segoe UI Light" Margin="0,24,0,12" Visibility="{Binding HasRelated, Converter={StaticResource NavidromeVisibility}}"/>
            <GridView ItemsSource="{Binding Related}" ItemTemplate="{StaticResource NavidromeTileTemplate}" IsItemClickEnabled="True" SelectionMode="None"
                cal:Message.Attach="[Event ItemClick]=[Action OpenRelated($eventArgs)]">
                <GridView.ItemsPanel><ItemsPanelTemplate><WrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</framework:AppPage>
