<framework:AppPage x:Class="Subsonic8.Navidrome.NavidromeDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Subsonic8.Common" xmlns:framework="using:Subsonic8.Framework" xmlns:cal="using:Caliburn.Micro" xmlns:selection="using:Common.Behaviors">
    <Page.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="NavidromeResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Page.Resources>
    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Name="Play" x:Uid="Navidrome_Play" Icon="Play"/>
            <AppBarButton x:Name="PlayNext" x:Uid="Navidrome_PlayNext" Icon="Forward"/>
            <AppBarButton x:Name="Append" x:Uid="Navidrome_Append" Icon="Add"/>
            <AppBarButton x:Name="Favourite" x:Uid="Navidrome_Favourite" Icon="Favorite"/>
            <AppBarButton x:Name="Reload" x:Uid="Navidrome_Refresh" Icon="Refresh"/>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="Download" x:Uid="Navidrome_Download"/>
                <AppBarButton x:Name="Unfavourite" x:Uid="Navidrome_Unfavourite"/>
                <AppBarButton x:Uid="Navidrome_Rate" IsEnabled="{Binding CanRate}" cal:Message.Attach="[Event Click]=[Action Rate($source)]"/>
                <AppBarButton x:Name="ArtistMix" x:Uid="Navidrome_ArtistMix"/>
                <AppBarButton x:Name="TopSongs" x:Uid="Navidrome_TopSongs"/>
                <AppBarButton x:Name="SonicMix" x:Uid="Navidrome_SonicMix"/>
                <AppBarButton x:Name="SonicPath" x:Uid="Navidrome_SonicPath" cal:Message.Attach="[Event Click]=[Action SonicPath($source)]"/>
                <AppBarButton x:Uid="Navidrome_CreatePlaylist" IsEnabled="{Binding CanCreatePlaylist}" cal:Message.Attach="[Event Click]=[Action CreatePlaylist($source)]"/>
                <AppBarButton x:Uid="Navidrome_AddToPlaylist" IsEnabled="{Binding CanAddToPlaylist}" cal:Message.Attach="[Event Click]=[Action AddToPlaylist($source)]"/>
                <AppBarButton x:Name="EditPlaylist" x:Uid="Navidrome_EditPlaylist" cal:Message.Attach="[Event Click]=[Action EditPlaylist($source)]"/>
                <AppBarButton x:Name="RemoveTracks" x:Uid="Navidrome_RemoveTracks"/>
                <AppBarButton x:Name="MoveUp" x:Uid="Navidrome_MoveUp"/>
                <AppBarButton x:Name="MoveDown" x:Uid="Navidrome_MoveDown"/>
                <AppBarButton x:Name="DeletePlaylist" x:Uid="Navidrome_DeletePlaylist"/>
                <AppBarButton x:Name="OpenExternal" x:Uid="Navidrome_OpenExternal"/>
                <AppBarButton x:Name="Bookmark" x:Uid="Navidrome_SaveBookmark" cal:Message.Attach="[Event Click]=[Action Bookmark($source)]"/>
                <AppBarButton x:Uid="Navidrome_CreateShare" IsEnabled="{Binding CanCreateShare}" cal:Message.Attach="[Event Click]=[Action CreateShare($source)]"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
    <Grid Background="Black">
        <Hub x:Name="DetailHub">
            <Hub.Header><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="GoBack" x:Uid="Navidrome_Back" Style="{StaticResource BackButtonStyle}" Margin="0,0,37,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="PageTitle" Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource ExtraLargeLightText}" MaxWidth="1500"/>
            </Grid></Hub.Header>
            <HubSection x:Name="OverviewSection" Margin="80,0,17,0"><DataTemplate>
                <ScrollViewer Width="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Loaded="OnOverviewLoaded">
                    <StackPanel>
                        <common:MixRadioArtwork Width="334" Height="334" HorizontalAlignment="Left" Source="{Binding ImageUrl}" DefaultSource="ms-appx:///Assets/MixRadio/PackArt-Explorer.Targetsize-256.png"/>
                        <TextBlock Text="{Binding Current.Subtitle}" Style="{StaticResource Medium2LightText}" Margin="0,20,0,0"/>
                        <TextBlock x:Uid="Navidrome_Starred" Text="★" Style="{StaticResource MediumLightText}" Foreground="{StaticResource NokiaPinkBrush}" Visibility="{Binding Current.IsStarred, Converter={StaticResource NavidromeVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding Metadata}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource NokiaPinkBrush}" Style="{StaticResource SmallRegularText}"/>
                                <TextBlock Text="{Binding Value}" Style="{StaticResource NormalText}" IsTextSelectionEnabled="True"/>
                            </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Notes}" Style="{StaticResource NormalText}" IsTextSelectionEnabled="True" Margin="0,12,0,24" Visibility="{Binding HasNotes, Converter={StaticResource NavidromeVisibility}}"/>
                    </StackPanel>
                </ScrollViewer>
            </DataTemplate></HubSection>
            <HubSection Visibility="{Binding HasTracks, Converter={StaticResource NavidromeVisibility}}">
                <HubSection.Header><TextBlock x:Uid="Navidrome_Tracks" Style="{StaticResource MediumLightText}" Margin="2,-5,0,-10"/></HubSection.Header>
                <DataTemplate><GridView ItemsSource="{Binding Tracks}" ItemTemplate="{StaticResource NavidromeTrackTemplate}" ItemContainerStyle="{StaticResource GridViewItemStyle}"
                    Width="620" Height="510" IsItemClickEnabled="True" SelectionMode="Multiple" Loaded="OnTracksLoaded" ItemClick="OnTrackClicked"
                    selection:MultipleSelectBehavior.SelectedItems="{Binding SelectedItems, Mode=TwoWay}">
                    <GridView.ItemsPanel><ItemsPanelTemplate><WrapGrid Orientation="Vertical"/></ItemsPanelTemplate></GridView.ItemsPanel>
                </GridView></DataTemplate>
            </HubSection>
            <HubSection Visibility="{Binding HasRelated, Converter={StaticResource NavidromeVisibility}}">
                <HubSection.Header><TextBlock x:Uid="Navidrome_Related" Style="{StaticResource MediumLightText}" Margin="2,-5,0,-10"/></HubSection.Header>
                <DataTemplate><GridView ItemsSource="{Binding Related}" ItemTemplateSelector="{StaticResource MixRadioHomeSmallSelector}" ItemContainerStyle="{StaticResource GridViewItemStyle}"
                    Width="510" Height="510" IsItemClickEnabled="True" SelectionMode="None" Loaded="OnRelatedLoaded" ItemClick="OnRelatedClicked">
                    <GridView.ItemsPanel><ItemsPanelTemplate><WrapGrid Orientation="Vertical"/></ItemsPanelTemplate></GridView.ItemsPanel>
                </GridView></DataTemplate>
            </HubSection>
        </Hub>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Width="280" Margin="0,30,32,0">
            <TextBlock Text="{Binding Error}" Style="{StaticResource NormalText}" Foreground="{StaticResource NokiaPinkBrush}" Visibility="{Binding HasError, Converter={StaticResource NavidromeVisibility}}"/>
            <ProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" HorizontalAlignment="Right" Visibility="{Binding IsLoading, Converter={StaticResource NavidromeVisibility}}"/>
            <ProgressRing IsActive="{Binding IsWorking}" Width="32" Height="32" HorizontalAlignment="Right" Visibility="{Binding IsWorking, Converter={StaticResource NavidromeVisibility}}"/>
        </StackPanel>
    </Grid>
</framework:AppPage>
