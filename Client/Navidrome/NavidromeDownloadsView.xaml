<framework:AppPage x:Class="Mixdrome.Navidrome.NavidromeDownloadsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:framework="using:Mixdrome.Framework" xmlns:cal="using:Caliburn.Micro" xmlns:selection="using:Common.Behaviors">
    <Page.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="NavidromeResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Page.Resources>
    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Name="Play" x:Uid="Navidrome_Play" Icon="Play"/>
            <AppBarButton x:Name="Append" x:Uid="Navidrome_Append" Icon="Add"/>
            <AppBarButton x:Name="Export" x:Uid="Navidrome_ExportOriginal" Icon="Save"/>
            <AppBarButton x:Name="Cancel" x:Uid="Navidrome_CancelDownload" Icon="Cancel"/>
            <AppBarButton x:Name="Reload" x:Uid="Navidrome_Refresh" Icon="Refresh"/>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="Retry" x:Uid="Navidrome_RetryDownload"/>
                <AppBarButton x:Name="Delete" x:Uid="Navidrome_DeleteDownload"/>
                <AppBarButton x:Name="CancelAll" x:Uid="Navidrome_CancelAllDownloads"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
    <Grid x:Name="Canvas" Background="Black">
        <Grid.RowDefinitions><RowDefinition Height="134"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="HeaderIndent" Width="116"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="GoBack" x:Uid="Navidrome_Back" Style="{StaticResource BackButtonStyle}"/>
            <TextBlock x:Name="PageTitle" Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource PageHeaderTextStyle}"/>
        </Grid>
        <StackPanel x:Name="Feedback" Grid.Row="1" Margin="116,0,40,20">
            <TextBlock Text="{Binding Error}" Style="{StaticResource NormalText}" Foreground="{StaticResource NokiaPinkBrush}" Visibility="{Binding HasError, Converter={StaticResource NavidromeVisibility}}"/>
            <ProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" HorizontalAlignment="Left" Visibility="{Binding IsLoading, Converter={StaticResource NavidromeVisibility}}"/>
            <ProgressRing IsActive="{Binding IsWorking}" Width="32" Height="32" HorizontalAlignment="Left" Visibility="{Binding IsWorking, Converter={StaticResource NavidromeVisibility}}"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <TextBlock x:Name="EmptyMessage" x:Uid="Navidrome_NoDownloads" Style="{StaticResource MediumLightText}" Margin="116,0,40,0" Visibility="{Binding IsEmpty, Converter={StaticResource NavidromeVisibility}}"/>
            <GridView x:Name="DownloadsList" ItemsSource="{Binding Offline.Entries}" ItemTemplate="{StaticResource MixRadioOfflineTemplate}" ItemContainerStyle="{StaticResource GridViewItemStyle}"
                IsItemClickEnabled="True" SelectionMode="Multiple" Padding="116,0,40,20" ItemClick="OnItemClicked"
                selection:MultipleSelectBehavior.SelectedItems="{Binding SelectedItems, Mode=TwoWay}">
                <GridView.ItemsPanel><ItemsPanelTemplate><WrapGrid Orientation="Vertical"/></ItemsPanelTemplate></GridView.ItemsPanel>
            </GridView>
        </Grid>
    </Grid>
</framework:AppPage>
