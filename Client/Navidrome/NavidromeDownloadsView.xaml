<framework:AppPage x:Class="Subsonic8.Navidrome.NavidromeDownloadsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:framework="using:Subsonic8.Framework" xmlns:cal="using:Caliburn.Micro" xmlns:selection="using:Common.Behaviors">
    <Page.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="NavidromeResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Page.Resources>
    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Name="Play" x:Uid="Navidrome_Play" Icon="Play"/>
            <AppBarButton x:Name="Append" x:Uid="Navidrome_Append" Icon="Add"/>
            <AppBarButton x:Name="Export" x:Uid="Navidrome_ExportOriginal" Icon="Save"/>
            <AppBarButton x:Name="Cancel" x:Uid="Navidrome_CancelDownload" Icon="Cancel"/>
            <AppBarButton x:Name="Reload" x:Uid="Navidrome_Refresh" Icon="Refresh"/>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="Retry" x:Uid="Navidrome_RetryDownload"/>
                <AppBarButton x:Name="Delete" x:Uid="Navidrome_DeleteDownload"/>
                <AppBarButton x:Name="CancelAll" x:Uid="Navidrome_CancelAllDownloads"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
    <Grid x:Name="Canvas" Margin="88,30,48,40">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="GoBack" x:Uid="Navidrome_Back" Content="&#xE112;" FontFamily="Segoe UI Symbol" MinHeight="40" MinWidth="40"/>
            <TextBlock x:Name="PageTitle" Grid.Column="1" Text="{Binding DisplayName}" FontSize="44" FontFamily="Segoe UI Light" Margin="12,0,0,0" TextTrimming="WordEllipsis"/>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,16,0,20">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource NavidromeVisibility}}"/>
            <ProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" HorizontalAlignment="Left" Visibility="{Binding IsLoading, Converter={StaticResource NavidromeVisibility}}"/>
            <ProgressRing IsActive="{Binding IsWorking}" Width="32" Height="32" HorizontalAlignment="Left" Visibility="{Binding IsWorking, Converter={StaticResource NavidromeVisibility}}"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <TextBlock x:Uid="Navidrome_NoDownloads" FontSize="24" TextWrapping="Wrap" Visibility="{Binding IsEmpty, Converter={StaticResource NavidromeVisibility}}"/>
            <ListView ItemsSource="{Binding Offline.Entries}" IsItemClickEnabled="True" SelectionMode="Multiple" HorizontalContentAlignment="Stretch"
                selection:MultipleSelectBehavior.SelectedItems="{Binding SelectedItems, Mode=TwoWay}" cal:Message.Attach="[Event ItemClick]=[Action OpenItem($eventArgs)]">
                <ListView.ItemTemplate><DataTemplate>
                    <Grid MinHeight="88" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="{Binding ImageUrl}" Width="60" Height="60" VerticalAlignment="Top" Stretch="UniformToFill"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{Binding Title}" FontSize="22" FontFamily="Segoe UI Light" TextTrimming="WordEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="13" TextTrimming="WordEllipsis"/>
                            <TextBlock Text="{Binding StateText}" Foreground="{StaticResource MixRadioAccentBrush}" Margin="0,6,0,0"/>
                            <StackPanel Visibility="{Binding IsTransferring, Converter={StaticResource NavidromeVisibility}}">
                                <TextBlock Text="{Binding Stage}" Margin="0,4,0,0"/>
                                <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Margin="0,8,0,4"/>
                                <TextBlock Text="{Binding ProgressText}" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0" Visibility="{Binding HasError, Converter={StaticResource NavidromeVisibility}}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</framework:AppPage>
