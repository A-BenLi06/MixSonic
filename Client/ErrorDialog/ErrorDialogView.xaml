<Page
    x:Class="Mixdrome.ErrorDialog.ErrorDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cal="using:Caliburn.Micro" xmlns:converters="using:Common.Converters" xmlns:common="using:Mixdrome.Common"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <UserControl.Resources>
        <cal:BooleanToVisibilityConverter x:Name="BooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Name="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#F6000000">
        <Image Source="/Assets/CoverArtPlaceholderLarge.jpg"
               Stretch="UniformToFill"
               Opacity="0.08" />
        <Rectangle Fill="#EE000000" />

        <Grid Margin="88,48,88,58">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0,0,42,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Uid="AppName" Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                               FontFamily="Segoe UI Light"
                               FontSize="40" />
                    <Border Width="20"
                            Height="20"
                            CornerRadius="10"
                            Margin="10,15,0,0"
                            BorderBrush="{StaticResource ApplicationForegroundThemeBrush}"
                            BorderThickness="1.5">
                        <TextBlock Text="&#xE102;"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="9"
                                   Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0" />
                    </Border>
                </StackPanel>

                <TextBlock Text="something went wrong"
                           Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                           FontFamily="Segoe UI Light"
                           FontSize="54"
                           TextWrapping="Wrap"
                           Margin="0,26,0,0" />
                <Rectangle Width="96"
                           Height="5"
                           Fill="{StaticResource MixRadioAccentBrush}"
                           HorizontalAlignment="Left"
                           Margin="0,18,0,24" />
                <TextBlock Text="{Binding Path=Notice}"
                           Style="{StaticResource ErrorDescription}"
                           Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}" />
                <TextBlock Text="{Binding Path=ErrorDescription}"
                           Style="{StaticResource ErrorDescription}"
                           Foreground="{StaticResource ApplicationForegroundThemeBrush}" />
                <TextBlock Text="{Binding Path=Message}"
                           Style="{StaticResource ErrorDescription}"
                           Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}" />
            </StackPanel>

            <Grid Grid.Column="1"
                  VerticalAlignment="Center"
                  Background="{StaticResource MixRadioAccentDarkBrush}"
                  Visibility="{Binding Path=ExceptionString, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="18,16,18,12">
                    <TextBlock Text="diagnostics"
                               Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                               FontFamily="Segoe UI Light"
                               FontSize="28" />
                    <TextBlock Text="technical details"
                               Foreground="#CCFFFFFF"
                               FontSize="14"
                               Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Margin="18,0,18,18">
                    <ToggleSwitch x:Name="ShowErrorButton"
                                  OnContent="hide error"
                                  OffContent="show error"
                                  IsOn="False"
                                  Style="{StaticResource LightToggleSwitch}" />
                    <TextBox x:Name="ExceptionString"
                             IsReadOnly="True"
                             Height="260"
                             Width="340"
                             AcceptsReturn="True"
                             Style="{StaticResource SettingsTextBoxStyle}"
                             Visibility="{Binding Path=IsOn, ElementName=ShowErrorButton, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,28,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button cal:Message.Attach="[Event Click] = [Action ShowSettings]" Content="settings"
                        Width="130" Margin="0,0,12,0" Style="{StaticResource LightButton}" />
                <Button cal:Message.Attach="[Event Click] = [Action ReportErrorDetails]" Content="send anonymously"
                        Width="170" Margin="0,0,12,0" Style="{StaticResource LightButton}" />
                <Button cal:Message.Attach="[Event Click] = [Action ShareErrorDetails]" Content="send by email"
                        Width="150" Margin="0,0,0,0" Style="{StaticResource LightButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
