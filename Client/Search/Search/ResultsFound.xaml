<ContentControl
    x:Class="Mixdrome.Search.Search.ResultsFound"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="using:Caliburn.Micro"
    xmlns:behaviors="using:Common.Behaviors">
    <ContentControl.Resources>
        <CollectionViewSource x:Key="GroupedSource" IsSourceGrouped="True" Source="{Binding GroupedMenuItems}" />
        <DataTemplate x:Key="MenuItemTemplate"><ContentControl cal:View.Model="{Binding}" /></DataTemplate>
    </ContentControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock Text="{Binding SearchQueryCaption}" FontSize="20" TextTrimming="WordEllipsis" Margin="0,8,0,0" />
        <GridView Grid.Row="1" ItemsSource="{Binding Source={StaticResource GroupedSource}}"
                  ItemTemplate="{StaticResource MenuItemTemplate}" SelectionMode="Multiple"
                  behaviors:MultipleSelectBehavior.SelectedItems="{Binding SelectedItems, Mode=TwoWay}"
                  IsItemClickEnabled="True" cal:Message.Attach="[Event ItemClick] = [Action ChildClick($eventArgs)]"
                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <GridView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate></GridView.ItemsPanel>
            <GridView.GroupStyle><GroupStyle>
                <GroupStyle.HeaderTemplate><DataTemplate>
                    <TextBlock Text="{Binding Key}" Foreground="{StaticResource MixRadioAccentBrush}" FontFamily="Segoe UI Light" FontSize="28" Margin="0,12,0,16" />
                </DataTemplate></GroupStyle.HeaderTemplate>
                <GroupStyle.Panel><ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GroupStyle.Panel>
            </GroupStyle></GridView.GroupStyle>
        </GridView>
    </Grid>
</ContentControl>
