<ContentControl
    x:Class="Subsonic8.Search.Search.ResultsFound"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cal="using:Caliburn.Micro"
    xmlns:behaviors="using:Common.Behaviors"
    mc:Ignorable="d">

    <ContentControl.Resources>
        <CollectionViewSource x:Key="GroupedSource" IsSourceGrouped="True" Source="{Binding GroupedMenuItems}" />
        <DataTemplate x:Key="MenuItemTemplate">
            <ContentControl cal:View.Model="{Binding}" />
        </DataTemplate>
    </ContentControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="116,20,116,0">
            <Rectangle Width="5"
                       Height="50"
                       Fill="{StaticResource MixRadioAccentBrush}"
                       Margin="0,6,18,0" />
            <StackPanel>
                <TextBlock Text="results"
                           Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                           FontFamily="Segoe UI Light"
                           FontSize="34" />
                <TextBlock Text="{Binding SearchQueryCaption}"
                           Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}"
                           FontFamily="Segoe UI Light"
                           FontSize="18"
                           TextTrimming="WordEllipsis" />
            </StackPanel>
        </StackPanel>

        <GridView Grid.Row="1"
                  Margin="0,0,0,0"
                  Padding="116,6,116,46"
                  SelectionMode="Multiple"
                  ItemsSource="{Binding Source={StaticResource GroupedSource}}"
                  behaviors:MultipleSelectBehavior.SelectedItems="{Binding SelectedItems, Mode=TwoWay}"
                  ItemTemplate="{StaticResource MenuItemTemplate}"
                  IsItemClickEnabled="True"
                  cal:Message.Attach="[Event ItemClick] = [Action ChildClick($eventArgs)];">

            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <GridView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Margin="20,8,24,18">
                                <TextBlock Text="{Binding Key}"
                                           Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                                           FontFamily="Segoe UI Light"
                                           FontSize="32"
                                           TextTrimming="WordEllipsis" />
                                <Rectangle Width="64"
                                           Height="4"
                                           Fill="{StaticResource MixRadioAccentBrush}"
                                           HorizontalAlignment="Left"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>

                    <GroupStyle.Panel>
                        <ItemsPanelTemplate>
                            <VariableSizedWrapGrid Orientation="Vertical" MaximumRowsOrColumns="2" />
                        </ItemsPanelTemplate>
                    </GroupStyle.Panel>
                </GroupStyle>
            </GridView.GroupStyle>
        </GridView>
    </Grid>
</ContentControl>
