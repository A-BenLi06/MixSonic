<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="MixRadioOriginalStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Compatibility names for existing desktop views, backed by the recovered palette. -->
    <Color x:Key="MixRadioAccentColor">#FFFF2E80</Color>
    <Color x:Key="MixRadioAccentDarkColor">#FFC4166C</Color>
    <Color x:Key="MixRadioTealColor">#FFFF2E80</Color>
    <Color x:Key="MixRadioYellowColor">#FFFF2E80</Color>
    <Color x:Key="MixRadioGreenColor">#FFFF2E80</Color>
    <Color x:Key="MixRadioPanelColor">#FF000000</Color>
    <Color x:Key="MixRadioPanelAltColor">#FF1D1D1D</Color>
    <SolidColorBrush x:Key="MixRadioAccentBrush" Color="{StaticResource NokiaPink}" />
    <SolidColorBrush x:Key="MixRadioAccentDarkBrush" Color="{StaticResource NokiaDarkPink}" />
    <SolidColorBrush x:Key="MixRadioTealBrush" Color="{StaticResource NokiaPink}" />
    <SolidColorBrush x:Key="MixRadioYellowBrush" Color="{StaticResource NokiaPink}" />
    <SolidColorBrush x:Key="MixRadioGreenBrush" Color="{StaticResource NokiaPink}" />
    <SolidColorBrush x:Key="MixRadioPanelBrush" Color="Black" />
    <SolidColorBrush x:Key="MixRadioPanelAltBrush" Color="{StaticResource AppBarColour}" />
    <SolidColorBrush x:Key="MixRadioTileBorderBrush" Color="{StaticResource NokiaPink}" />
    <SolidColorBrush x:Key="MixRadioControlForegroundBrush" Color="White" />
    <Style x:Key="MixRadioTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButton}" />
    <Style x:Key="MixRadioCompactTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}" />
</ResourceDictionary>
