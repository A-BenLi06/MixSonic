<UserControl
    x:Class="Subsonic8.Common.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cal="using:Caliburn.Micro"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid Margin="88,26,88,14">
        <Grid.Resources>
            <cal:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InvertedBooleanToVisibilityConverter
                xmlns:converters="using:Subsonic8.Converters"
                x:Key="InvertedBooleanToVisibilityConverter" />
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button Style="{StaticResource BackButtonStyle}"
                Margin="-60,10,28,0"
                VerticalAlignment="Top"
                Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}"
                cal:Message.Attach="[Event Click] = [Action GoBack]" />

        <StackPanel Grid.Column="1"
                    Orientation="Vertical"
                    Visibility="{Binding CanGoBack, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{StaticResource ApplicationHeaderForegroundThemeBrush}"
                           FontFamily="Segoe UI"
                           FontSize="52"
                           LineHeight="56">
                    <Run Text="Mix" FontWeight="SemiBold" />
                    <Run Text="Radio" FontWeight="Light" />
                </TextBlock>
                <Border Width="26"
                        Height="26"
                        CornerRadius="13"
                        Margin="12,18,0,0"
                        BorderBrush="{StaticResource ApplicationHeaderForegroundThemeBrush}"
                        BorderThickness="2">
                    <TextBlock Text="&#xE102;"
                               FontFamily="Segoe UI Symbol"
                               FontSize="11"
                               Foreground="{StaticResource ApplicationHeaderForegroundThemeBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="2,0,0,0" />
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding Path=DisplayName}"
                       Foreground="{StaticResource ApplicationHeaderForegroundThemeBrush}"
                       FontFamily="Segoe UI Light"
                       FontSize="26"
                       TextWrapping="NoWrap"
                       TextTrimming="WordEllipsis" />
        </StackPanel>

        <TextBlock Grid.Column="1"
                   Text="{Binding Path=DisplayName}"
                   Foreground="{StaticResource ApplicationHeaderForegroundThemeBrush}"
                   FontFamily="Segoe UI Light"
                   FontSize="52"
                   Margin="0,14,0,0"
                   TextWrapping="NoWrap"
                   TextTrimming="WordEllipsis"
                   Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>
