<UserControl
    x:Class="Mixdrome.Common.BrowseViews.Snapped"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="using:Caliburn.Micro"
    xmlns:common="using:Mixdrome.Common"
    xmlns:converters="using:Mixdrome.Converters"
    KeyDown="OnCanvasKeyDown">
    <UserControl.Resources>
        <cal:BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </UserControl.Resources>
    <Grid Margin="24,24,24,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Style="{StaticResource BackButtonStyle}" Margin="0,0,12,0" cal:Message.Attach="[Event Click] = [Action GoBack]"
                    Visibility="{Binding CanGoBack, Converter={StaticResource VisibleWhenTrue}}" />
            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontFamily="Segoe UI Light" FontSize="32" TextTrimming="WordEllipsis" />
        </Grid>
        <common:LibrarySearch x:Name="LibrarySearch" Grid.Row="1" Margin="0,0,0,16" />
        <ScrollViewer Grid.Row="2" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel>
                <Grid cal:Bind.Model="{Binding PlayerSummary}" Margin="0,0,0,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Image Source="{Binding CurrentItem.CoverArtUrl}" Width="64" Height="64" Margin="0,0,12,0" Stretch="UniformToFill"
                               Visibility="{Binding HasCurrentItem, Converter={StaticResource VisibleWhenTrue}}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontSize="20" TextTrimming="WordEllipsis" />
                            <TextBlock Text="{Binding Artist}" FontSize="16" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Grid.Row="1" DataContext="{Binding Progress}" Maximum="{Binding ItemDurationInSeconds}"
                                 Value="{Binding PlaybackProgressInSeconds}" Height="4" Margin="0,12,0,12" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Style="{StaticResource MixRadioCompactTransportButtonStyle}" Content="&#xE100;" IsEnabled="{Binding HasQueue}"
                                AutomationProperties.Name="{Binding PreviousLabel}" cal:Message.Attach="[Event Click] = [Action Previous]" />
                        <Button Style="{StaticResource MixRadioCompactTransportButtonStyle}" Content="{Binding PlayPauseGlyph}" IsEnabled="{Binding HasQueue}"
                                Background="{StaticResource MixRadioAccentBrush}" AutomationProperties.Name="{Binding PlayPauseLabel}"
                                cal:Message.Attach="[Event Click] = [Action PlayPause]" />
                        <Button Style="{StaticResource MixRadioCompactTransportButtonStyle}" Content="&#xE101;" IsEnabled="{Binding HasQueue}"
                                AutomationProperties.Name="{Binding NextLabel}" cal:Message.Attach="[Event Click] = [Action Next]" />
                        <Button Style="{StaticResource MixRadioCompactTransportButtonStyle}" Content="&#xE14C;" IsEnabled="{Binding HasQueue}"
                                AutomationProperties.Name="{Binding QueueLabel}" cal:Message.Attach="[Event Click] = [Action OpenQueue]" />
                        <Button Style="{StaticResource MixRadioCompactTransportButtonStyle}" Content="&#xE10C;" x:Uid="PlayerOptions">
                            <Button.Flyout><Flyout><StackPanel>
                                <Button Content="{Binding FavouriteLabel}" IsEnabled="{Binding CanToggleFavourite}" cal:Action.TargetWithoutContext="{Binding}"
                                        cal:Message.Attach="[Event Click] = [Action ToggleFavourite]" />
                                <Button Content="{Binding RepeatLabel}" cal:Action.TargetWithoutContext="{Binding}" cal:Message.Attach="[Event Click] = [Action ToggleRepeat]" />
                                <Button Content="{Binding ShuffleLabel}" cal:Action.TargetWithoutContext="{Binding}" cal:Message.Attach="[Event Click] = [Action ToggleShuffle]" />
                            </StackPanel></Flyout></Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
                <ProgressRing IsActive="{Binding IsLoading}" Width="44" Height="44" HorizontalAlignment="Left"
                              Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhenTrue}}" />
                <TextBlock Text="{Binding EmptyStateTitle}" FontSize="24" TextWrapping="Wrap"
                           Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}" />
                <TextBlock Text="{Binding EmptyStateSubtitle}" FontSize="16" TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}" />
                <ListView ItemsSource="{Binding MenuItems}" SelectionMode="None" IsItemClickEnabled="True"
                          cal:Message.Attach="[Event ItemClick] = [Action ChildClick($eventArgs)]">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid Width="64" Height="64" Background="{Binding AccentBrush}">
                                <Image Source="{Binding CoverArt}" Stretch="UniformToFill" />
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsCommandTile, Converter={StaticResource VisibleWhenTrue}}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{Binding Title}" FontSize="20" TextTrimming="WordEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="16" TextTrimming="WordEllipsis" Margin="0,6,0,0"
                                           Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
