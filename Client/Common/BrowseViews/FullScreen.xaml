<UserControl
    x:Class="Subsonic8.Common.BrowseViews.FullScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:caliburn="using:Caliburn.Micro"
    xmlns:common="using:Subsonic8.Common"
    xmlns:behaviors="using:Common.Behaviors"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <UserControl.Resources>
        <caliburn:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="MenuItemTemplate">
            <ContentControl caliburn:View.Model="{Binding}" />
        </DataTemplate>
        <CollectionViewSource x:Name="GroupedMenuItemsSource"
                              IsSourceGrouped="True"
                              Source="{Binding GroupedMenuItems}" />
        <DataTemplate x:Key="LetterHeaderTemplate">
            <Border Width="132"
                    Height="34"
                    Margin="0,0,0,14"
                    HorizontalAlignment="Left"
                    BorderBrush="{StaticResource MixRadioAccentBrush}"
                    BorderThickness="2">
                <TextBlock Text="{Binding Key}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MixRadioAccentBrush}"
                           FontFamily="Segoe UI Light"
                           FontSize="20" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollMode="Enabled"
                  VerticalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
    <Grid Width="2560"
          Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="900" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="148" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image Grid.ColumnSpan="2"
               Grid.RowSpan="2"
               Source="/Assets/CoverArtPlaceholderLarge.jpg"
               Stretch="UniformToFill"
               Opacity="0.06" />
        <Rectangle Grid.ColumnSpan="2"
                   Grid.RowSpan="2"
                   Fill="#F6000000" />

        <common:PageHeader Grid.ColumnSpan="2"
                           DataContext="{Binding}"/>

        <Grid Grid.Column="1"
              Margin="0,34,88,0"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Width="260"
              Height="30"
              Background="#33000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchInput"
                     Margin="0"
                     Padding="10,2,0,0"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                     PlaceholderText="Find artists, music or gigs"
                     FontSize="12"
                     VerticalAlignment="Stretch"
                     KeyUp="OnSearchInputKeyUp" />
            <Border Grid.Column="1"
                    Background="{StaticResource MixRadioAccentBrush}"
                    Tapped="OnSearchTapped">
                <TextBlock Text="&#xE11A;"
                           FontFamily="Segoe UI Symbol"
                           FontSize="14"
                           Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>

        <Grid Grid.Row="1"
              Grid.Column="0"
              Width="760"
              Margin="88,0,32,46"
              HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="258" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="258"
                      Height="258"
                      HorizontalAlignment="Left"
                      Background="{StaticResource MixRadioPanelAltBrush}">
                    <Image Source="/Assets/CoverArtPlaceholderLarge.jpg"
                           Stretch="UniformToFill"
                           Opacity="0.92" />
                    <Rectangle Fill="#18000000" />
                    <Rectangle Height="4"
                               Fill="{StaticResource MixRadioAccentBrush}"
                               VerticalAlignment="Bottom" />
                </Grid>

                <Grid Grid.Column="1"
                      Margin="24,18,0,0"
                      VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding DisplayName}"
                               Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                               FontFamily="Segoe UI Light"
                               FontSize="32"
                               Margin="0,0,0,0"
                               TextWrapping="Wrap"
                               TextTrimming="WordEllipsis" />
                    <TextBlock Grid.Row="1"
                               Text="Navidrome music"
                               Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}"
                               FontFamily="Segoe UI Light"
                               FontSize="18"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               TextTrimming="WordEllipsis" />
                </Grid>
            </Grid>

            <Grid Grid.Row="1"
                  Width="258"
                  Height="12"
                  HorizontalAlignment="Left"
                  Margin="0,14,0,0">
                <Rectangle Height="4"
                           Fill="#FF2D2D2D"
                           VerticalAlignment="Center" />
                <Rectangle Width="26"
                           Height="4"
                           Fill="{StaticResource MixRadioAccentBrush}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
                <TextBlock Text="0:00"
                           Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}"
                           FontSize="10"
                           HorizontalAlignment="Left"
                           Margin="0,-16,0,0" />
                <TextBlock Text="3:32"
                           Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}"
                           FontSize="10"
                           HorizontalAlignment="Right"
                           Margin="0,-16,0,0" />
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,24,0,0">
                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        BorderBrush="{StaticResource ApplicationSecondaryForegroundThemeBrush}"
                        BorderThickness="2"
                        Margin="0,0,16,0">
                    <TextBlock Text="&#xE100;"
                               FontFamily="Segoe UI Symbol"
                               FontSize="21"
                               Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <Border Width="62"
                        Height="62"
                        CornerRadius="31"
                        BorderBrush="{StaticResource ApplicationForegroundThemeBrush}"
                        BorderThickness="2"
                        Margin="0,-5,16,0">
                    <TextBlock Text="&#xE102;"
                               FontFamily="Segoe UI Symbol"
                               FontSize="28"
                               Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />
                </Border>
                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        BorderBrush="{StaticResource ApplicationSecondaryForegroundThemeBrush}"
                        BorderThickness="2"
                        Margin="0,0,16,0">
                    <TextBlock Text="&#xE101;"
                               FontFamily="Segoe UI Symbol"
                               FontSize="21"
                               Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <Border Width="38"
                        Height="38"
                        CornerRadius="19"
                        BorderBrush="{StaticResource ApplicationSecondaryForegroundThemeBrush}"
                        BorderThickness="2"
                        Margin="0,7,0,0">
                    <TextBlock Text="&#xE14C;"
                               FontFamily="Segoe UI Symbol"
                               FontSize="17"
                               Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="3"
                       Text="recently played"
                       Margin="0,28,0,0"
                       Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}"
                       FontSize="15"
                       TextTrimming="WordEllipsis" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Text="library"
                   Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                   FontFamily="Segoe UI Light"
                   FontSize="24"
                   Margin="0,0,88,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top" />

        <GridView x:Name="GroupedItems"
                  Grid.Row="1"
                  Grid.Column="1"
                  Margin="0"
                  Padding="0,52,88,46"
                  SelectionMode="Multiple"
                  ItemTemplate="{StaticResource MenuItemTemplate}"
                  Visibility="{Binding ShowGroupedItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                  behaviors:MultipleSelectBehavior.SelectedItems="{Binding SelectedItems, Mode=TwoWay}"
                  IsItemClickEnabled="True" caliburn:Message.Attach="[Event ItemClick] = [ChildClick($eventArgs)]"
                  ItemsSource="{Binding Source={StaticResource GroupedMenuItemsSource}}"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource LetterHeaderTemplate}">
                    <GroupStyle.Panel>
                        <ItemsPanelTemplate>
                            <VariableSizedWrapGrid Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </GroupStyle.Panel>
                </GroupStyle>
            </GridView.GroupStyle>
        </GridView>

        <GridView x:Name="MenuItems"
                  Grid.Row="1"
                  Grid.Column="1"
                  Margin="0"
                  Padding="0,52,88,46"
                  SelectionMode="Multiple"
                  ItemTemplate="{StaticResource MenuItemTemplate}"
                  Visibility="{Binding ShowFlatItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                  behaviors:MultipleSelectBehavior.SelectedItems="{Binding SelectedItems, Mode=TwoWay}"
                  IsItemClickEnabled="True" caliburn:Message.Attach="[Event ItemClick] = [ChildClick($eventargs)]"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VariableSizedWrapGrid Orientation="Vertical" MaximumRowsOrColumns="2" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>

        <Grid Grid.Row="1"
              Grid.Column="1"
              Width="560"
              MinHeight="230"
              Margin="0,58,88,46"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Rectangle Width="96"
                       Height="5"
                       HorizontalAlignment="Left"
                       Fill="{StaticResource MixRadioAccentBrush}" />
            <TextBlock Grid.Row="1"
                       Text="{Binding EmptyStateTitle}"
                       Margin="0,22,0,0"
                       Foreground="{StaticResource ApplicationForegroundThemeBrush}"
                       FontFamily="Segoe UI Light"
                       FontSize="42"
                       TextWrapping="Wrap"
                       TextTrimming="WordEllipsis" />
            <TextBlock Grid.Row="2"
                       Text="{Binding EmptyStateSubtitle}"
                       Margin="0,12,0,0"
                       Width="500"
                       HorizontalAlignment="Left"
                       Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}"
                       FontFamily="Segoe UI Light"
                       FontSize="20"
                       LineHeight="28"
                       TextWrapping="Wrap"
                       TextTrimming="WordEllipsis" />
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
