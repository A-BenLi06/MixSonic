<UserControl
    x:Class="Mixdrome.Common.BrowseViews.FullScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="using:Caliburn.Micro"
    xmlns:common="using:Mixdrome.Common"
    xmlns:player="using:Mixdrome.BrowsePlayer"
    xmlns:behaviors="using:Common.Behaviors"
    xmlns:converters="using:Mixdrome.Converters"
    KeyDown="OnCanvasKeyDown">
    <UserControl.Resources>
        <cal:BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="VisibleWhenFalse" />
        <CollectionViewSource x:Key="GroupedSource" IsSourceGrouped="True" Source="{Binding GroupedMenuItems}" />
        <DataTemplate x:Key="MenuItemTemplate"><ContentControl cal:View.Model="{Binding}" /></DataTemplate>
        <DataTemplate x:Key="LetterHeader">
            <TextBlock Text="{Binding Key}" FontFamily="Segoe UI Light" FontSize="32"
                       Foreground="{StaticResource MixRadioAccentBrush}" Margin="0,0,0,16" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="132" /><RowDefinition Height="48" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <common:PageHeader DataContext="{Binding}" />
        <common:LibrarySearch x:Name="LibrarySearch" Grid.Row="1" Margin="88,0,88,0" MaxWidth="440" HorizontalAlignment="Stretch" />
        <Hub x:Name="BrowseHub" Grid.Row="2" Margin="72,16,24,24" HorizontalAlignment="Stretch">
            <HubSection x:Uid="PlayerSection" Width="420">
                <DataTemplate>
                    <player:PlayerSummaryView cal:Bind.Model="{Binding PlayerSummary}" />
                </DataTemplate>
            </HubSection>
            <HubSection Header="{Binding DisplayName}" MinWidth="360">
                <DataTemplate>
                    <Grid MinWidth="360">
                        <GridView ItemsSource="{Binding Source={StaticResource GroupedSource}}"
                                  ItemTemplate="{StaticResource MenuItemTemplate}" SelectionMode="Multiple"
                                  IsItemClickEnabled="True" cal:Message.Attach="[Event ItemClick] = [Action ChildClick($eventArgs)]"
                                  behaviors:MultipleSelectBehavior.SelectedItems="{Binding SelectedItems, Mode=TwoWay}"
                                  Visibility="{Binding ShowGroupedItems, Converter={StaticResource VisibleWhenTrue}}"
                                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <GridView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                            <GridView.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource LetterHeader}">
                                    <GroupStyle.Panel><ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Vertical" MaximumRowsOrColumns="2" /></ItemsPanelTemplate></GroupStyle.Panel>
                                </GroupStyle>
                            </GridView.GroupStyle>
                        </GridView>
                        <GridView ItemsSource="{Binding MenuItems}" ItemTemplate="{StaticResource MenuItemTemplate}"
                                  SelectionMode="Multiple" IsItemClickEnabled="True"
                                  cal:Message.Attach="[Event ItemClick] = [Action ChildClick($eventArgs)]"
                                  behaviors:MultipleSelectBehavior.SelectedItems="{Binding SelectedItems, Mode=TwoWay}"
                                  Visibility="{Binding ShowFlatItems, Converter={StaticResource VisibleWhenTrue}}"
                                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <GridView.ItemsPanel><ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Vertical" MaximumRowsOrColumns="2" /></ItemsPanelTemplate></GridView.ItemsPanel>
                        </GridView>
                        <ProgressRing IsActive="{Binding IsLoading}" Width="48" Height="48"
                                      HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhenTrue}}" />
                        <StackPanel Width="360" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Text="{Binding EmptyStateTitle}" FontFamily="Segoe UI Light" FontSize="32" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding EmptyStateSubtitle}" FontSize="18" Margin="0,16,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </HubSection>
            <HubSection x:Uid="RecentSection" Width="460" Visibility="{Binding ShowRecentListening, Converter={StaticResource VisibleWhenTrue}}">
                <DataTemplate>
                    <Grid cal:Bind.Model="{Binding PlayerSummary}">
                        <ListView ItemsSource="{Binding RecentTracks}" SelectionMode="None" IsItemClickEnabled="True"
                                  cal:Message.Attach="[Event ItemClick] = [Action ReplayRecent($eventArgs)]">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Image Source="{Binding CoverArt}" Width="64" Height="64" Stretch="UniformToFill" />
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="20" TextTrimming="WordEllipsis" />
                                            <TextBlock Text="{Binding Artist}" FontSize="16" Margin="0,6,0,0" TextTrimming="WordEllipsis"
                                                       Foreground="{StaticResource ApplicationSecondaryForegroundThemeBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="{Binding RecentEmptyLabel}" FontSize="18" TextWrapping="Wrap"
                                   Visibility="{Binding HasRecentTracks, Converter={StaticResource VisibleWhenFalse}}" />
                        <TextBlock Text="{Binding HistoryError}" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource MixRadioAccentBrush}" />
                    </Grid>
                </DataTemplate>
            </HubSection>
        </Hub>
    </Grid>
</UserControl>
